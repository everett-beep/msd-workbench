        ? table(['Plate', 'Sample', 'Spot', 'Dilution', 'Wells', 'N', 'Mean Signal', 'SD', 'CV'], rows)
        : '';
    }

    function renderStandards() {
      const concentrationByStandard = getCalibratorX();
      const rows = state.standards.map((row) => `
        <tr>
          <td>${escapeHtml(row.sample)}</td>
          <td>${escapeHtml(row.assay)}</td>
          <td>${fmt(row.level)}</td>
          <td>${fmt(concentrationByStandard.get(standardKey(row)))}</td>
          <td>${row.n}</td>
          <td>${fmt(row.mean)}</td>
          <td>${fmt(row.cv)}%</td>
