      `);
      el('standardsView').innerHTML = rows.length
        ? table(['Calibrator', 'Spot', 'Level', 'Concentration', 'N', 'Mean Signal', 'CV'], rows)
        : '<p class="empty">No calibrators matched the current calibrator pattern.</p>';
    }

    function renderCurves() {
      const rows = Math.ceil(state.curves.length / 2);
      const height = 120 + rows * 320;
      el('curvesView').innerHTML = state.curves.length
        ? `
          <div class="combined-chart">
            <div class="chart-title">
              All standard curves
              <span>${state.curves.length} spots</span>
            </div>
            <canvas id="combinedCurves" width="1600" height="${height}"></canvas>
          </div>
          ${renderPlateLegend()}
          <div class="chart-grid">${state.curves.map(renderChart).join('')}</div>
        `
        : '<p class="empty">At least two calibrator groups are needed for a linear fit and four are needed for a 4PL fit.</p>';

      if (state.curves.length) drawCombinedCurves(el('combinedCurves'));
    }

    function sampleRows() {
      return state.means.filter((row) => !row.calibrator && !row.control && !isBsaMean(row));
    }

    function selectedSampleRows(rows = sampleRows()) {
      return state.sampleDilution === 'all'
        ? rows
        : rows.filter((row) => (row.dilution || 'undiluted') === state.sampleDilution);
    }

    function sampleDilutionOptions(rows) {
      return [...new Set(rows.map((row) => row.dilution || 'undiluted'))]
        .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
    }

    function ensureSampleDilution(options) {
      if (state.sampleDilution === 'all' || options.includes(state.sampleDilution)) return;
      state.sampleDilution = 'all';
    }

    function sampleDilutionLabel(value) {
      if (value === 'all') return 'All dilutions';
      if (value === 'undiluted') return 'No dilution';
      return value;
    }

    function renderSamples() {
      const allSamples = sampleRows();
      if (!allSamples.length) {
        el('samplesView').innerHTML = '<p class="empty">No non-calibrator, non-control sample groups were found in the plate map.</p>';
        return;
      }

      const dilutionOptions = sampleDilutionOptions(allSamples);
      ensureSampleDilution(dilutionOptions);
      const samples = selectedSampleRows(allSamples);
      const sampleNames = sortedSampleNames(samples);
      const foldRows = foldChangeRows(samples);
      const sampleMode = state.sampleMode || 'raw-by-assay';
      const showDilution = sampleMode !== 'fold-summary';
      const tools = `
        <div class="sample-tools">
          <div class="field">
            <div class="mini-label">Graph view</div>
            <select id="sampleMode" class="secondary" aria-label="Sample graph view">
              ${[...SAMPLE_MODE_LABELS.entries()].map(([value, label]) => `<option value="${value}"${sampleMode === value ? ' selected' : ''}>${label}</option>`).join('')}
            </select>
          </div>
          ${showDilution ? `
          <div class="field">
            <div class="mini-label">Sample dilution</div>
            <select id="sampleDilution" class="secondary" aria-label="Sample dilution">
              <option value="all"${state.sampleDilution === 'all' ? ' selected' : ''}>All dilutions</option>
              ${dilutionOptions.map((dilution) => `<option value="${escapeHtml(dilution)}"${state.sampleDilution === dilution ? ' selected' : ''}>${escapeHtml(sampleDilutionLabel(dilution))}</option>`).join('')}
            </select>
          </div>
          ` : ''}
        </div>
      `;

      el('samplesView').innerHTML = `${tools}${renderSamplePlots(samples, sampleNames, foldRows, sampleMode)}`;
      if (sampleMode === 'fold-summary') drawFoldSummaryPreview();
    }

    function renderSamplePlots(samples, sampleNames, foldRows, sampleMode) {
      if (sampleMode === 'fold-summary') {
        return `
          <div class="combined-chart">
            <div class="chart-title">
              Matched-BSA fold change heat map
              <span>1:2 and 1:8</span>
            </div>
            <canvas id="foldSummaryPreview"></canvas>
          </div>
        `;
      }

      const bySpot = new Map();
      const rowsToGroup = sampleMode === 'fold-by-assay' ? foldRows : samples;
      const legendNames = sampleMode === 'fold-by-assay' ? sortedSampleNames(foldRows) : sampleNames;
      const legendEntries = sampleLegendEntries(legendNames);
      const legendBySample = new Map(legendEntries.map((entry) => [entry.sample, entry]));
      rowsToGroup.forEach((row) => {
        if (!bySpot.has(row.spot)) bySpot.set(row.spot, []);
        bySpot.get(row.spot).push(row);
      });

      const charts = state.spotNames.map((assay, index) => {
        const rows = bySpot.get(index + 1) || [];
        const chart = {
          spot: index + 1,
          assay,
          rows: rows
            .sort((a, b) => a.sample.localeCompare(b.sample, undefined, { numeric: true }))
            .map((row) => ({ ...row, legend: legendBySample.get(row.sample) })),
        };
        return sampleMode === 'fold-by-assay' ? renderFoldChart(chart) : renderSampleChart(chart);
      });

      const body = sampleMode === 'raw-log'
        ? renderSignalHeatmap(samples, sampleNames)
        : sampleMode === 'fold-log'
          ? renderFoldHeatmap(foldRows, sortedSampleNames(foldRows))
          : `${renderSampleLegend(legendEntries)}<div class="chart-grid">${charts.join('')}</div>`;

      return body;
    }

    function drawFoldSummaryPreview() {
      const preview = el('foldSummaryPreview');
      const source = drawFoldSummaryPng();
      if (!preview || !source) return;

      preview.width = source.width;
      preview.height = source.height;
      preview.getContext('2d').drawImage(source, 0, 0);
    }

    function renderSampleLegend(sampleNames) {
      return `
        <div class="sample-legend">
          ${sampleNames.map((entry) => `
            <div>
              <span><i style="background:${entry.color}"></i>${entry.key}</span>
              ${escapeHtml(entry.sample)}
            </div>
          `).join('')}
        </div>
      `;
    }

    function sampleLegendEntries(sampleNames) {
      return sampleNames.map((sample, index) => ({
        sample,
        key: `S${index + 1}`,
        color: SAMPLE_COLORS[index % SAMPLE_COLORS.length],
      }));
    }

    function plateColor(plate) {
      const plates = state.plates.map((entry) => entry.id);
      const index = Math.max(0, plates.indexOf(plate));
      return PLATE_COLORS[index % PLATE_COLORS.length];
    }

    function plateLegendEntries() {
      return state.plates.map((plate) => ({
        plate: plate.id,
        color: plateColor(plate.id),
      }));
    }

    function comparePlates(a, b) {
      const plates = state.plates.map((entry) => entry.id);
      const aIndex = plates.indexOf(a);
      const bIndex = plates.indexOf(b);
      return (aIndex < 0 ? Number.MAX_SAFE_INTEGER : aIndex) - (bIndex < 0 ? Number.MAX_SAFE_INTEGER : bIndex)
        || String(a).localeCompare(String(b), undefined, { numeric: true });
    }

    function controlProfileData(rows) {
      const expectedByLevel = new Map();
      const measuredByPlate = new Map();

      rows.forEach((row) => {
        if (!expectedByLevel.has(row.controlLevel)) {
          expectedByLevel.set(row.controlLevel, row);
        }

        if (!measuredByPlate.has(row.plate)) measuredByPlate.set(row.plate, new Map());
        measuredByPlate.get(row.plate).set(row.controlLevel, row);
      });

      return {
        expectedPoints: [1, 2, 3].map((level) => {
          const row = expectedByLevel.get(level);
          return { level, value: row?.expected };
        }),
        plateProfiles: [...measuredByPlate.keys()]
          .sort(comparePlates)
          .map((plate) => {
            const rowsByLevel = measuredByPlate.get(plate);
            return {
              plate,
              points: [1, 2, 3].map((level) => {
                const row = rowsByLevel.get(level);
                return {
                  level,
                  value: row?.calculated,
                  signal: row?.mean,
                  sample: row?.sample || `Control ${level}`,
                  recovery: row?.recovery,
                };
              }),
            };
          }),
      };
    }

    function renderPlateLegend() {
      const entries = plateLegendEntries();
      if (entries.length <= 1) return '';

      return `
        <div class="sample-legend">
          ${entries.map((entry) => `
            <span>
              <i style="background:${entry.color}"></i>
              ${escapeHtml(entry.plate)}
            </span>
          `).join('')}
        </div>
      `;
    }

    function renderControlProfileLegend() {
      const entries = plateLegendEntries();
      return `
        <div class="sample-legend">
          <span>
            <i class="coa-key"></i>
            COA expected
          </span>
          ${entries.map((entry) => `
            <span>
              <i style="background:${entry.color}"></i>
              ${escapeHtml(entry.plate)} measured
            </span>
          `).join('')}
        </div>
      `;
    }

    function sortedSampleNames(rows) {
      return [...new Set(rows.map((row) => row.sample))]
        .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
    }

    function foldChangeRows(rows) {
      const bsaByKey = new Map(
        state.means
          .filter(isBsaMean)
          .map((row) => [matchedBsaKey(row), row.mean])
      );

      return rows.map((row) => {
        const bsaMean = bsaByKey.get(matchedBsaKey(row));
        const fold = bsaMean > 0 ? row.mean / bsaMean : NaN;
        return {
          ...row,
          bsaMean,
          fold,
          log2Fold: Number.isFinite(fold) && fold > 0 ? Math.log2(fold) : NaN,
        };
      });
    }

    function caveatsForRow(row) {
      if (!row) return [];
      return state.analysisCaveats.filter((caveat) =>
        String(row.plate || '').toLowerCase() === caveat.plate.toLowerCase()
        && String(row.dilution || '').toLowerCase() === caveat.dilution.toLowerCase()
        && caveat.assayKeys.has(normalizeSpotName(row.assay))
      );
    }

    function hasAnalysisCaveat(row) {
      return caveatsForRow(row).length > 0;
    }

    function caveatRowsForPlate(plate) {
      return state.analysisCaveats.filter((caveat) => caveat.plate === plate);
    }

    function caveatLabel(caveat) {
      return `${caveat.plate} ${caveat.dilution} ${caveat.assays.join(', ')}: ${caveat.note}`;
    }

    function renderSignalHeatmap(rows, sampleNames) {
      const values = rows.map((row) => Math.log10(row.mean + 1)).filter(Number.isFinite);
      const min = Math.min(...values);
      const max = Math.max(...values);
      const byKey = new Map(rows.map((row) => [`${row.sample}::${row.spot}`, row]));
      return renderHeatmap({
        samples: sampleNames,
        valueFor: (sample, spot) => byKey.get(`${sample}::${spot}`)?.mean,
        labelFor: (value) => fmt(value),
        colorFor: (value) => sequentialColor(Math.log10(value + 1), min, max),
      });
    }

    function renderFoldHeatmap(rows, sampleNames) {
      const byKey = new Map(rows.map((row) => [`${row.sample}::${row.spot}`, row]));
      const maxAbs = Math.max(1, ...rows.map((row) => Math.abs(row.log2Fold)).filter(Number.isFinite));
      return renderHeatmap({
        samples: sampleNames,
        valueFor: (sample, spot) => byKey.get(`${sample}::${spot}`)?.fold,
        labelFor: (value) => Number.isFinite(value) ? `${fmt(value)}x` : '',
        colorFor: (value) => divergingColor(Math.log2(value), maxAbs),
      });
    }

    function renderHeatmap({ samples, valueFor, labelFor, colorFor }) {
      const columns = `136px repeat(${state.spotNames.length}, 1fr)`;
      const headers = state.spotNames.map((assay) => `<div class="heatmap-head">${escapeHtml(assay)}</div>`).join('');
      const rows = samples.map((sample) => `
        <div class="heatmap-sample" title="${escapeHtml(sample)}">${escapeHtml(sample)}</div>
        ${state.spotNames.map((_, index) => {
          const value = valueFor(sample, index + 1);
          return `<div class="heatmap-cell" style="background:${colorFor(value)}">${labelFor(value)}</div>`;
        }).join('')}
      `).join('');
      return `
        <div class="heatmap-wrap">
          <div class="heatmap" style="grid-template-columns:${columns}">
            <div class="heatmap-head"></div>
            ${headers}
            ${rows}
          </div>
        </div>
      `;
    }

    function renderQc() {
      if (!state.qc.length && !state.controlQc.length && !state.analysisCaveats.length) {
        el('qcView').innerHTML = '<p class="empty">No calibrators or controls were available for QC.</p>';
        return;
      }

      const reviewed = state.qc.filter((row) => row.status !== 'Pass').length;
      const rows = state.qc.map((row) => `
        <tr>
          <td>${escapeHtml(row.assay)}</td>
          <td>${escapeHtml(row.sample)}</td>
          <td>${fmt(row.concentration)}</td>
          <td>${fmt(row.calculated)}</td>
          <td>${fmt(row.recovery)}%</td>
          <td>${fmt(row.cv)}%</td>
          <td>${row.range ? fmt(row.range.llod) : ''}</td>
          <td>${row.range ? `${fmt(row.range.lloq)}-${fmt(row.range.uloq)}` : ''}</td>
          <td>${escapeHtml(row.rangeStatus)}</td>
          <td>${qcBadge(row.status)}</td>
        </tr>
      `);
      const controlReviewed = state.controlQc.filter((row) => row.status !== 'Pass').length;
      const recoveryReviewed = state.controlQc.filter((row) => !row.recoveryPass).length;
      const precisionReviewed = state.controlQc.filter((row) => !row.cvPass).length;
      const controlProfileCharts = renderControlProfileCharts();
      const caveatNotes = state.analysisCaveats.map(caveatLabel);
      const controlRows = state.controlQc.map((row) => `
        <tr>
          <td>${escapeHtml(row.assay)}</td>
          <td>${escapeHtml(row.curveAssay)}</td>
          <td>${escapeHtml(row.sample)}</td>
          <td>${escapeHtml(row.lot)}</td>
          <td>${fmt(row.mean)}</td>
          <td>${fmt(row.target)}</td>
          <td>${fmt(row.expected)}</td>
          <td>${fmt(row.calculated)}</td>
          <td>${fmt(row.recovery)}%</td>
          <td>${fmt(row.cv)}%</td>
          <td>${qcBadge(row.recoveryQc, row.recoveryPass)}</td>
          <td>${qcBadge(row.cvQc, row.cvPass)}</td>
          <td>${qcBadge(row.qc, row.status === 'Pass')}</td>
        </tr>
      `);

      el('qcView').innerHTML = `
        ${caveatNotes.length ? `
          <div class="qc-summary review">
            ${caveatNotes.length} analysis caveat${caveatNotes.length === 1 ? '' : 's'} flagged for review.
            <p class="empty qc-note">${caveatNotes.map(escapeHtml).join('<br>')}</p>
          </div>
        ` : ''}
        ${state.qc.length ? `
          <div class="qc-summary ${reviewed ? 'review' : 'pass'}">
            ${reviewed
              ? `${reviewed} calibrator points need review.`
              : 'All nonblank calibrators passed 75-125% recovery and signal CV <= 25%.'}
          </div>
          ${table(['Spot', 'Calibrator', 'Nominal', 'Back-fit', 'Recovery', 'Signal CV', 'LLOD', 'LLOQ-ULOQ', 'Range', 'Fit QC'], rows)}
        ` : ''}
        ${state.controlQc.length ? `
          <div class="qc-summary ${controlReviewed ? 'review' : 'pass'}">
            ${controlReviewed
              ? `${controlReviewed} control points need review: ${recoveryReviewed} outside 20% of expected; ${precisionReviewed} at intra-run CV >= 7%.`
              : 'All controls were within 20% of expected concentration and intra-run CV < 7%.'}
            <p class="empty qc-note">Expected pg/mL = COA pg/mL x 250 µL / your reconstitution volume / post-reconstitution dilution. Inter-run CV needs the same controls measured across multiple runs.</p>
          </div>
          ${table(['Signal Spot', 'Curve Used', 'Control', 'Lot', 'Mean Signal', 'COA pg/mL', 'Expected pg/mL', 'Back-fit pg/mL', 'Recovery', 'Intra-run CV', 'Recovery QC', 'CV QC', 'QC'], controlRows)}
          ${controlProfileCharts}
        ` : ''}
      `;
    }

    function qcBadge(label, pass = label === 'Pass') {
      return `<span class="qc-badge ${pass ? 'pass' : 'review'}">${escapeHtml(label)}</span>`;
    }

    function renderSampleChart(chart) {
      const width = 420;
      const slot = 20;
      const plotHeight = Math.max(120, Math.max(1, chart.rows.length) * slot);
      const height = 58 + plotHeight;
      const pad = { l: 48, r: 20, t: 16, b: 42 };
      const plotWidth = width - pad.l - pad.r;
      const maxY = Math.max(1, ...chart.rows.map((row) => row.mean));
      const barHeight = Math.min(12, slot - 6);

      const bars = chart.rows.map((row, index) => {
        const y = pad.t + index * slot + (slot - barHeight) / 2;
        const barWidth = (row.mean / maxY) * plotWidth;
        return `
          <rect x="${pad.l}" y="${y.toFixed(1)}" width="${barWidth.toFixed(1)}" height="${barHeight}" rx="2" fill="${row.legend?.color || SAMPLE_COLORS[0]}">
            <title>${escapeHtml(row.sample)}: mean ${fmt(row.mean)} | CV ${fmt(row.cv)}%</title>
          </rect>
        `;
      }).join('');
      const labels = chart.rows.map((row, index) => `
        <text class="sample-label" x="${pad.l - 8}" y="${(pad.t + index * slot + slot / 2 + 3).toFixed(1)}" text-anchor="end">
          ${escapeHtml(row.legend?.key || '')}
        </text>
      `).join('');

      return `
        <div class="chart">
          <div class="chart-title">${escapeHtml(chart.assay)} <span>${chart.rows.length} samples</span></div>
          <svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${escapeHtml(chart.assay)} sample signals">
            <line class="axis" x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${pad.t + plotHeight}"></line>
            <line class="axis" x1="${pad.l}" y1="${pad.t + plotHeight}" x2="${width - pad.r}" y2="${pad.t + plotHeight}"></line>
            ${[0, 0.5, 1].map((t) => {
              const x = pad.l + t * plotWidth;
              return `<line class="grid" x1="${x}" x2="${x}" y1="${pad.t}" y2="${pad.t + plotHeight}"></line>`;
            }).join('')}
            ${bars}
            ${labels}
            <text x="${pad.l}" y="${pad.t + plotHeight + 16}" text-anchor="middle" font-size="11" fill="#687383">0</text>
            <text x="${width - pad.r}" y="${pad.t + plotHeight + 16}" text-anchor="end" font-size="11" fill="#687383">${fmt(maxY)}</text>
            <text x="${pad.l}" y="${height - 8}" font-size="11" fill="#687383">Mean sample signal</text>
          </svg>
        </div>
      `;
    }

    function renderControlProfileCharts() {
      if (!state.controlQc.length) return '';

      const rowsByAssay = new Map();
      state.controlQc.forEach((row) => {
        const key = normalizeSpotName(row.assay);
        if (!rowsByAssay.has(key)) rowsByAssay.set(key, []);
        rowsByAssay.get(key).push(row);
      });

      const charts = state.spotNames.map((assay) =>
        renderControlProfileChart(assay, rowsByAssay.get(normalizeSpotName(assay)) || [])
      );

      return `${renderControlProfileLegend()}<div class="chart-grid">${charts.join('')}</div>`;
    }

    function renderControlProfileChart(assay, rows) {
      const width = 420;
      const height = 244;
      const pad = { l: 56, r: 18, t: 18, b: 54 };
      const plotWidth = width - pad.l - pad.r;
      const plotHeight = height - pad.t - pad.b;
      const profile = controlProfileData(rows);
      const values = [
        ...profile.expectedPoints.map((point) => point.value),
        ...profile.plateProfiles.flatMap((plate) => plate.points.map((point) => point.value)),
      ]
        .filter((value) => Number.isFinite(value) && value > 0);
      const min = Math.min(...values, 1) * 0.75;
      const max = Math.max(...values, 10) * 1.25;
      const minLog = Math.log10(min);
      const maxLog = Math.log10(max);
      const sx = (level) => pad.l + ((level - 1) / 2) * plotWidth;
      const sy = (value) => {
        if (!Number.isFinite(value) || value <= 0) return NaN;
        return height - pad.b - ((Math.log10(value) - minLog) / (maxLog - minLog || 1)) * plotHeight;
      };
      const line = (points) => points
        .filter((point) => Number.isFinite(point.value) && point.value > 0)
        .map((point) => `${sx(point.level).toFixed(1)},${sy(point.value).toFixed(1)}`)
        .join(' ');

      return `
        <div class="chart">
          <div class="chart-title">
            ${escapeHtml(assay)}
            <span>Control concentration profile</span>
          </div>
          <svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${escapeHtml(assay)} control concentration profile">
            <line class="axis" x1="${pad.l}" y1="${height - pad.b}" x2="${width - pad.r}" y2="${height - pad.b}"></line>
            <line class="axis" x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${height - pad.b}"></line>
            ${[0, 0.5, 1].map((t) => {
              const y = pad.t + t * plotHeight;
              return `<line class="grid" x1="${pad.l}" x2="${width - pad.r}" y1="${y}" y2="${y}"></line>`;
            }).join('')}
            <polyline class="coa-line" points="${line(profile.expectedPoints)}"></polyline>
            ${profile.plateProfiles.map((plate) => `<polyline class="measured-line" style="stroke:${plateColor(plate.plate)}" points="${line(plate.points)}"><title>${escapeHtml(plate.plate)}</title></polyline>`).join('')}
            ${profile.expectedPoints.map((point) => Number.isFinite(point.value) && point.value > 0
              ? `<circle class="coa-pt" cx="${sx(point.level)}" cy="${sy(point.value)}" r="4.5"><title>Expected Control ${point.level}: ${fmt(point.value)} pg/mL</title></circle>`
              : '').join('')}
            ${profile.plateProfiles.flatMap((plate) => plate.points.map((point) => Number.isFinite(point.value) && point.value > 0
              ? `<circle class="measured-pt" style="fill:${plateColor(plate.plate)}" cx="${sx(point.level)}" cy="${sy(point.value)}" r="4.5"><title>${escapeHtml(plate.plate)} ${escapeHtml(point.sample)}: signal ${fmt(point.signal)} | ${fmt(point.value)} pg/mL | recovery ${fmt(point.recovery)}%</title></circle>`
              : '')).join('')}
            ${[1, 2, 3].map((level) => `<text x="${sx(level)}" y="${height - pad.b + 18}" text-anchor="middle" font-size="11" fill="#687383">C${level}</text>`).join('')}
            <text x="${pad.l}" y="${height - 10}" font-size="11" fill="#687383">Control level</text>
            <text x="${pad.l - 8}" y="${pad.t + 4}" text-anchor="end" font-size="11" fill="#687383">${fmt(max)}</text>
            <text x="${pad.l - 8}" y="${height - pad.b + 4}" text-anchor="end" font-size="11" fill="#687383">${fmt(min)}</text>
            <line class="coa-line" x1="${width - 126}" x2="${width - 104}" y1="${height - 18}" y2="${height - 18}"></line>
            <text x="${width - 100}" y="${height - 14}" font-size="10" fill="#687383">COA</text>
          </svg>
        </div>
      `;
    }

    function renderFoldChart(chart) {
      const width = 420;
      const slot = 20;
      const plotHeight = Math.max(120, Math.max(1, chart.rows.length) * slot);
      const height = 58 + plotHeight;
      const pad = { l: 48, r: 20, t: 16, b: 42 };
      const plotWidth = width - pad.l - pad.r;
      const maxAbs = Math.max(1, ...chart.rows.map((row) => Math.abs(row.log2Fold)).filter(Number.isFinite));
      const sx = (value) => pad.l + ((value + maxAbs) / (maxAbs * 2)) * plotWidth;
      const zeroX = sx(0);
      const barHeight = Math.min(12, slot - 6);

      const bars = chart.rows.map((row, index) => {
        if (!Number.isFinite(row.log2Fold)) return '';
        const x = sx(Math.min(0, row.log2Fold));
        const y = pad.t + index * slot + (slot - barHeight) / 2;
        const width = Math.abs(sx(row.log2Fold) - zeroX);
        return `
          <rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${Math.max(1, width).toFixed(1)}" height="${barHeight}" rx="2" fill="${row.legend?.color || SAMPLE_COLORS[0]}">
            <title>${escapeHtml(row.sample)}: ${fmt(row.fold)}x | mean ${fmt(row.mean)}</title>
          </rect>
        `;
      }).join('');
      const labels = chart.rows.map((row, index) => `
        <text class="sample-label" x="${pad.l - 8}" y="${(pad.t + index * slot + slot / 2 + 3).toFixed(1)}" text-anchor="end">
          ${escapeHtml(row.legend?.key || '')}
        </text>
      `).join('');

      return `
        <div class="chart">
          <div class="chart-title">${escapeHtml(chart.assay)} <span>${chart.rows.length} samples</span></div>
          <svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${escapeHtml(chart.assay)} fold changes">
            <line class="axis" x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${pad.t + plotHeight}"></line>
            <line class="axis" x1="${pad.l}" y1="${pad.t + plotHeight}" x2="${width - pad.r}" y2="${pad.t + plotHeight}"></line>
            <line class="grid" x1="${zeroX}" x2="${zeroX}" y1="${pad.t}" y2="${pad.t + plotHeight}"></line>
            ${bars}
            ${labels}
            <text x="${pad.l}" y="${pad.t + plotHeight + 16}" text-anchor="middle" font-size="11" fill="#687383">-${fmt(maxAbs, 2)}</text>
            <text x="${zeroX}" y="${pad.t + plotHeight + 16}" text-anchor="middle" font-size="11" fill="#687383">0</text>
            <text x="${width - pad.r}" y="${pad.t + plotHeight + 16}" text-anchor="end" font-size="11" fill="#687383">+${fmt(maxAbs, 2)}</text>
            <text x="${pad.l}" y="${height - 12}" font-size="11" fill="#687383">log2 fold over matched BSA</text>
          </svg>
        </div>
      `;
    }

    function truncateLabel(value, max) {
      const text = String(value);
      return text.length > max ? `${text.slice(0, max - 1)}…` : text;
    }

    function sequentialColor(value, min, max) {
      if (!Number.isFinite(value)) return '#ffffff';
      const t = (value - min) / (max - min || 1);
      return blend('#f8fafc', '#2563eb', Math.max(0, Math.min(1, t)));
    }

    function divergingColor(value, maxAbs) {
      if (!Number.isFinite(value)) return '#ffffff';
      const clamped = Math.max(-1, Math.min(1, value / (maxAbs || 1)));
      return clamped >= 0
        ? blend('#ffffff', '#be123c', clamped)
        : blend('#2563eb', '#ffffff', clamped + 1);
    }

    function blend(a, b, t) {
      const ar = parseInt(a.slice(1, 3), 16);
      const ag = parseInt(a.slice(3, 5), 16);
      const ab = parseInt(a.slice(5, 7), 16);
      const br = parseInt(b.slice(1, 3), 16);
      const bg = parseInt(b.slice(3, 5), 16);
      const bb = parseInt(b.slice(5, 7), 16);
      const hex = (value) => Math.round(value).toString(16).padStart(2, '0');
      return `#${hex(ar + (br - ar) * t)}${hex(ag + (bg - ag) * t)}${hex(ab + (bb - ab) * t)}`;
    }

    function renderChart(curve) {
      const width = 420;
      const height = 260;
      const pad = { l: 64, r: 20, t: 20, b: 48 };
      const controlPoints = controlPointsForCurve(curve);
      const xs = [...curve.points.map((p) => p.x), ...controlPoints.map((p) => p.x)];
      const plateSamplePoints = curve.plateModels.map((plateCurve) => ({
        plate: plateCurve.plate,
        points: sampleCurve(plateCurve),
      }));
      const ys = [
        ...curve.points.map((p) => p.y),
        ...controlPoints.map((p) => p.y),
        ...plateSamplePoints.flatMap((plateCurve) => plateCurve.points.map((p) => p.y)),
      ].filter(Number.isFinite);
      const minX = Math.min(...xs);
      const maxX = Math.max(...xs);
      const minY = Math.min(...ys);
      const maxY = Math.max(...ys);
      const dx = maxX - minX || 1;
      const dy = maxY - minY || 1;
      const sx = (x) => pad.l + ((x - minX) / dx) * (width - pad.l - pad.r);
      const sy = (y) => height - pad.b - ((y - minY) / dy) * (height - pad.t - pad.b);

      return `
        <div class="chart">
          <div class="chart-title">
            ${escapeHtml(curve.assay)}
            <span>${curve.model.type} R² ${fmt(curve.model.r2, 4)} · ${controlPoints.length} controls</span>
          </div>
          <svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${escapeHtml(curve.assay)} standard curve">
            <line class="axis" x1="${pad.l}" y1="${height - pad.b}" x2="${width - pad.r}" y2="${height - pad.b}"></line>
            <line class="axis" x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${height - pad.b}"></line>
            ${[0, 0.5, 1].map((t) => {
              const y = pad.t + t * (height - pad.t - pad.b);
              return `<line class="grid" x1="${pad.l}" x2="${width - pad.r}" y1="${y}" y2="${y}"></line>`;
            }).join('')}
            ${plateSamplePoints.map((plateCurve) => {
              const points = plateCurve.points.map((point) => `${sx(point.x).toFixed(1)},${sy(point.y).toFixed(1)}`).join(' ');
              return `<polyline class="fit" style="stroke:${plateColor(plateCurve.plate)}" points="${points}"><title>${escapeHtml(plateCurve.plate)}</title></polyline>`;
            }).join('')}
            ${curve.points.map((p) => `<circle class="pt" style="fill:${plateColor(p.plate)}" cx="${sx(p.x)}" cy="${sy(p.y)}" r="4.5"><title>${escapeHtml(p.sample)}: ${fmt(p.y)}</title></circle>`).join('')}
            ${controlPoints.map((p) => {
              const x = sx(p.x);
              const y = sy(p.y);
              return `<polygon class="control-pt" points="${x.toFixed(1)},${(y - 6).toFixed(1)} ${(x - 6).toFixed(1)},${(y + 5).toFixed(1)} ${(x + 6).toFixed(1)},${(y + 5).toFixed(1)}"><title>${escapeHtml(p.sample)}: signal ${fmt(p.y)} → ${fmt(p.x)} pg/mL</title></polygon>`;
            }).join('')}
            <circle class="pt" cx="${pad.l}" cy="${height - 16}" r="4"></circle>
            <text x="${pad.l + 8}" y="${height - 12}" font-size="10" fill="#687383">Cal</text>
            <polygon class="control-pt" points="${pad.l + 50},${height - 20} ${pad.l + 45},${height - 11} ${pad.l + 55},${height - 11}"></polygon>
            <text x="${pad.l + 62}" y="${height - 12}" font-size="10" fill="#687383">Control</text>
            <text x="${width - pad.r}" y="${height - 12}" text-anchor="end" font-size="11" fill="#687383">${fmt(minX)}-${fmt(maxX)} pg/mL</text>
            <text x="${pad.l - 8}" y="${pad.t + 4}" text-anchor="end" font-size="11" fill="#687383">${fmt(maxY)}</text>
            <text x="${pad.l - 8}" y="${height - pad.b + 4}" text-anchor="end" font-size="11" fill="#687383">${fmt(minY)}</text>
          </svg>
        </div>
      `;
    }

    function sampleCurve(curve, min = null, max = null) {
      const xs = curve.points.map((p) => p.x);
      const minX = min ?? Math.min(...xs);
      const maxX = max ?? Math.max(...xs);
      return Array.from({ length: 80 }, (_, index) => {
        const x = minX + ((maxX - minX) * index) / 79;
        return { x, y: curve.model.predict(x) };
      });
    }

    function controlPointsForCurve(curve) {
      const assayKey = normalizeSpotName(curve.assay);
      return state.controlQc
        .filter((row) => normalizeSpotName(row.assay) === assayKey)
        .filter((row) => Number.isFinite(row.calculated) && Number.isFinite(row.mean))
        .map((row) => ({ x: row.calculated, y: row.mean, sample: row.sample, status: row.status }));
    }

    function drawCombinedCurves(canvas) {
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      const width = canvas.width;
      const height = canvas.height;
      const columns = 2;
      const margin = 44;
      const gap = 28;
      const titleHeight = 64;
      const cardWidth = (width - margin * 2 - gap) / columns;
      const cardHeight = 292;
      const pad = { l: 82, r: 22, t: 66, b: 54 };

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
      ctx.fillStyle = '#17212f';
      ctx.font = '800 30px Inter, Arial, sans-serif';
      ctx.fillText('MSD standard curves', margin, 42);
      ctx.fillStyle = '#687383';
      ctx.font = '500 18px Inter, Arial, sans-serif';
      ctx.fillText(`${state.curves.length} spots`, margin + 330, 42);
      drawCanvasLegend(ctx, margin + 445, 30);

      state.curves.forEach((curve, index) => {
        const col = index % columns;
        const row = Math.floor(index / columns);
        const x = margin + col * (cardWidth + gap);
        const y = titleHeight + margin + row * (cardHeight + gap);
        const plot = {
          x: x + pad.l,
          y: y + pad.t,
          w: cardWidth - pad.l - pad.r,
          h: cardHeight - pad.t - pad.b,
        };
        const controls = controlPointsForCurve(curve);
        const xs = [...curve.points.map((p) => p.x), ...controls.map((p) => p.x)];
        const minX = Math.min(...xs);
        const maxX = Math.max(...xs);
        const samplesByPlate = curve.plateModels.map((plateCurve) => ({
          plate: plateCurve.plate,
          points: sampleCurve(plateCurve, minX, maxX),
        }));
        const ys = [
          ...curve.points.map((p) => p.y),
          ...controls.map((p) => p.y),
          ...samplesByPlate.flatMap((plateCurve) => plateCurve.points.map((p) => p.y)),
        ].filter(Number.isFinite);
        const minY = Math.min(...ys);
        const maxY = Math.max(...ys);
        const dx = maxX - minX || 1;
        const dy = maxY - minY || 1;
        const sx = (value) => plot.x + ((value - minX) / dx) * plot.w;
        const sy = (value) => plot.y + plot.h - ((value - minY) / dy) * plot.h;

        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#d9dee7';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.roundRect(x, y, cardWidth, cardHeight, 10);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#17212f';
        ctx.font = '800 17px Inter, Arial, sans-serif';
        ctx.fillText(curve.assay, x + 16, y + 28);
        ctx.fillStyle = '#687383';
        ctx.font = '600 13px Inter, Arial, sans-serif';
        ctx.fillText(`${curve.model.type} R2 ${fmt(curve.model.r2, 4)}`, x + 16, y + 48);

        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 1;
        [0, 0.5, 1].forEach((t) => {
          const gy = plot.y + plot.h * t;
          ctx.beginPath();
          ctx.moveTo(plot.x, gy);
          ctx.lineTo(plot.x + plot.w, gy);
          ctx.stroke();
        });

        ctx.strokeStyle = '#cbd5e1';
        ctx.beginPath();
        ctx.moveTo(plot.x, plot.y);
        ctx.lineTo(plot.x, plot.y + plot.h);
        ctx.lineTo(plot.x + plot.w, plot.y + plot.h);
        ctx.stroke();

        ctx.lineWidth = 4;
        samplesByPlate.forEach((plateCurve) => {
          ctx.strokeStyle = plateColor(plateCurve.plate);
          ctx.beginPath();
          plateCurve.points.forEach((point, pointIndex) => {
            const px = sx(point.x);
            const py = sy(point.y);
            if (pointIndex === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          });
          ctx.stroke();
        });

        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 3;
        curve.points.forEach((point) => {
          ctx.fillStyle = plateColor(point.plate);
          ctx.beginPath();
          ctx.arc(sx(point.x), sy(point.y), 6, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        });

        ctx.fillStyle = '#2563eb';
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 3;
        controls.forEach((point) => {
          const px = sx(point.x);
          const py = sy(point.y);
          ctx.beginPath();
          ctx.moveTo(px, py - 8);
          ctx.lineTo(px - 8, py + 7);
          ctx.lineTo(px + 8, py + 7);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        });

        ctx.fillStyle = '#687383';
        ctx.font = '500 12px Inter, Arial, sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText(fmt(maxY), plot.x - 10, plot.y);
        ctx.fillText(fmt(minY), plot.x - 10, plot.y + plot.h);
        ctx.textAlign = 'left';
        ctx.textBaseline = 'alphabetic';
        ctx.fillText(`${fmt(minX)}-${fmt(maxX)} pg/mL`, plot.x, y + cardHeight - 18);
      });
    }

    function drawCanvasLegend(ctx, x, y) {
      ctx.save();
      ctx.fillStyle = '#b45309';
      ctx.beginPath();
      ctx.arc(x, y, 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#687383';
      ctx.font = '700 13px Inter, Arial, sans-serif';
      ctx.fillText('Calibrators', x + 12, y + 5);

      const tx = x + 116;
      ctx.fillStyle = '#2563eb';
      ctx.beginPath();
      ctx.moveTo(tx, y - 7);
      ctx.lineTo(tx - 7, y + 6);
      ctx.lineTo(tx + 7, y + 6);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = '#687383';
      ctx.fillText('Controls', tx + 12, y + 5);

      let px = tx + 105;
      plateLegendEntries().forEach((entry) => {
        ctx.fillStyle = entry.color;
        ctx.beginPath();
        ctx.arc(px, y, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#687383';
        ctx.fillText(entry.plate, px + 12, y + 5);
        px += 58;
      });
      ctx.restore();
    }

    function drawPngHeader(ctx, title, subtitle, width) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, ctx.canvas.height);
      ctx.fillStyle = '#17212f';
      ctx.font = '800 30px Inter, Arial, sans-serif';
      ctx.fillText(title, 44, 42);
      ctx.fillStyle = '#687383';
      ctx.font = '500 18px Inter, Arial, sans-serif';
      ctx.fillText(subtitle, 44, 68);
    }

    function drawCardFrame(ctx, x, y, width, height, title, subtitle) {
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#d9dee7';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect(x, y, width, height, 10);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#17212f';
      ctx.font = '800 17px Inter, Arial, sans-serif';
      ctx.fillText(title, x + 16, y + 28);
      ctx.fillStyle = '#687383';
      ctx.font = '600 13px Inter, Arial, sans-serif';
      ctx.fillText(subtitle, x + 16, y + 48);
    }

    function drawSamplePng() {
      const allSamples = sampleRows();
      if (!allSamples.length) return null;

      ensureSampleDilution(sampleDilutionOptions(allSamples));
      const samples = selectedSampleRows(allSamples);
      const sampleNames = sortedSampleNames(samples);
      const foldRows = foldChangeRows(samples);
      const sampleMode = state.sampleMode || 'raw-by-assay';
      if (sampleMode === 'fold-summary') return drawFoldSummaryPng();

      return sampleMode === 'raw-log'
        ? drawSampleHeatmapPng(samples, sampleNames, sampleMode)
        : sampleMode === 'fold-log'
          ? drawSampleHeatmapPng(foldRows, sortedSampleNames(foldRows), sampleMode)
          : drawSampleBarPng(samples, sampleNames, foldRows, sampleMode);
    }

    function drawSampleBarPng(samples, sampleNames, foldRows, sampleMode) {
      const rowsToGroup = sampleMode === 'fold-by-assay' ? foldRows : samples;
      const legendNames = sampleMode === 'fold-by-assay'
        ? sortedSampleNames(foldRows)
        : sampleNames;
      const legendEntries = sampleLegendEntries(legendNames);
      const legendBySample = new Map(legendEntries.map((entry) => [entry.sample, entry]));
      const bySpot = new Map();
      rowsToGroup.forEach((row) => {
        if (!bySpot.has(row.spot)) bySpot.set(row.spot, []);
        bySpot.get(row.spot).push(row);
      });

      const columns = 2;
      const margin = 44;
      const gap = 28;
      const cardWidth = (1600 - margin * 2 - gap) / columns;
      const legendRows = Math.ceil(legendNames.length / 3);
      const legendHeight = legendNames.length ? 24 + legendRows * 24 : 0;
      const titleHeight = 86 + legendHeight;
      const maxRows = Math.max(1, ...state.spotNames.map((_, index) => bySpot.get(index + 1)?.length || 0));
      const cardHeight = 118 + Math.max(120, maxRows * 24);
      const rows = Math.ceil(state.spotNames.length / columns);
      const canvas = document.createElement('canvas');
      canvas.width = 1600;
      canvas.height = titleHeight + margin * 2 + rows * cardHeight + (rows - 1) * gap;
      const ctx = canvas.getContext('2d');
      drawPngHeader(
        ctx,
        'MSD sample graphs',
        `${SAMPLE_MODE_LABELS.get(sampleMode)} · ${sampleDilutionLabel(state.sampleDilution)}`,
        canvas.width
      );
      drawSampleLegendPng(ctx, legendEntries, margin, 88, canvas.width - margin * 2);

      state.spotNames.forEach((assay, index) => {
        const col = index % columns;
        const row = Math.floor(index / columns);
        const x = margin + col * (cardWidth + gap);
        const y = titleHeight + margin + row * (cardHeight + gap);
        const chart = {
          assay,
          rows: (bySpot.get(index + 1) || [])
            .sort((a, b) => a.sample.localeCompare(b.sample, undefined, { numeric: true }))
            .map((row) => ({ ...row, legend: legendBySample.get(row.sample) })),
        };
        drawSampleBarCard(ctx, chart, sampleMode === 'fold-by-assay', x, y, cardWidth, cardHeight);
      });

      return canvas;
    }

    function drawSampleLegendPng(ctx, entries, x, y, width) {
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#d9dee7';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect(x, y - 14, width, Math.ceil(entries.length / 3) * 24 + 16, 10);
      ctx.fill();
      ctx.stroke();

      const colWidth = width / 3;
      ctx.textBaseline = 'middle';
      entries.forEach((entry, index) => {
        const col = index % 3;
        const row = Math.floor(index / 3);
        const itemX = x + 16 + col * colWidth;
        const itemY = y + row * 24;
        ctx.fillStyle = entry.color;
        ctx.beginPath();
        ctx.roundRect(itemX, itemY - 6, 12, 12, 3);
        ctx.fill();
        ctx.fillStyle = '#17212f';
        ctx.font = '800 14px Inter, Arial, sans-serif';
        ctx.fillText(entry.key, itemX + 20, itemY);
        ctx.fillStyle = '#475569';
        ctx.font = '500 14px Inter, Arial, sans-serif';
        ctx.fillText(truncateLabel(entry.sample, 30), itemX + 62, itemY);
      });
