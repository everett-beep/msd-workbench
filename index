    function drawControlPngCard(ctx, assay, rows, x, y, width, height) {
      const pad = { l: 74, r: 22, t: 70, b: 54 };
      const plot = { x: x + pad.l, y: y + pad.t, w: width - pad.l - pad.r, h: height - pad.t - pad.b };
      const profile = controlProfileData(rows);
      const values = [
        ...profile.expectedPoints.map((point) => point.value),
        ...profile.plateProfiles.flatMap((plate) => plate.points.map((point) => point.value)),
      ]
        .filter((value) => Number.isFinite(value) && value > 0);
      const min = Math.min(...values, 1) * 0.75;
      const max = Math.max(...values, 10) * 1.25;
      const minLog = Math.log10(min);
      const maxLog = Math.log10(max);
      const sx = (level) => plot.x + ((level - 1) / 2) * plot.w;
      const sy = (value) => plot.y + plot.h - ((Math.log10(value) - minLog) / (maxLog - minLog || 1)) * plot.h;
      const drawLine = (points) => {
        ctx.beginPath();
        let started = false;
        points.forEach((point) => {
          if (!Number.isFinite(point.value) || point.value <= 0) return;
          const px = sx(point.level);
          const py = sy(point.value);
          if (!started) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
          started = true;
        });
        ctx.stroke();
      };

      drawCardFrame(ctx, x, y, width, height, assay, 'Control concentration profile');
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      [0, 0.5, 1].forEach((t) => {
        const gy = plot.y + plot.h * t;
        ctx.beginPath();
        ctx.moveTo(plot.x, gy);
        ctx.lineTo(plot.x + plot.w, gy);
        ctx.stroke();
      });
      ctx.strokeStyle = '#cbd5e1';
      ctx.beginPath();
      ctx.moveTo(plot.x, plot.y);
      ctx.lineTo(plot.x, plot.y + plot.h);
      ctx.lineTo(plot.x + plot.w, plot.y + plot.h);
      ctx.stroke();

      ctx.strokeStyle = '#b45309';
      ctx.lineWidth = 4;
      ctx.setLineDash([8, 6]);
      drawLine(profile.expectedPoints);
      ctx.setLineDash([]);

      profile.plateProfiles.forEach((plateProfile) => {
        ctx.strokeStyle = plateColor(plateProfile.plate);
        ctx.lineWidth = 4;
        drawLine(plateProfile.points);
      });

      profile.expectedPoints.forEach((point) => {
        if (!Number.isFinite(point.value) || point.value <= 0) return;
        ctx.fillStyle = '#b45309';
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(sx(point.level), sy(point.value), 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      });

      profile.plateProfiles.forEach((plateProfile) => {
        ctx.fillStyle = plateColor(plateProfile.plate);
        plateProfile.points.forEach((point) => {
          if (!Number.isFinite(point.value) || point.value <= 0) return;
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(sx(point.level), sy(point.value), 6, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        });
      });

      ctx.fillStyle = '#687383';
      ctx.font = '500 12px Inter, Arial, sans-serif';
      ctx.textAlign = 'center';
      [1, 2, 3].forEach((level) => ctx.fillText(`C${level}`, sx(level), plot.y + plot.h + 24));
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(fmt(max), plot.x - 10, plot.y);
      ctx.fillText(fmt(min), plot.x - 10, plot.y + plot.h);
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('Control level', plot.x, y + height - 18);

      ctx.strokeStyle = '#b45309';
      ctx.lineWidth = 4;
      ctx.setLineDash([8, 6]);
      ctx.beginPath();
      ctx.moveTo(x + width - 98, y + height - 22);
      ctx.lineTo(x + width - 70, y + height - 22);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillText('COA', x + width - 64, y + height - 17);
    }

