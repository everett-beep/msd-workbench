    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      })[ch]);
    }

    function toCsv(rows) {
      return rows.map((row) => row.map((cell) => {
        const text = String(cell ?? '');
        return /[",\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
      }).join(',')).join('\n');
    }

    function downloadCsv(name, rows) {
      const url = URL.createObjectURL(new Blob([toCsv(rows)], { type: 'text/csv' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.click();
      URL.revokeObjectURL(url);
    }

    function isBsaMean(row) {
      return canonicalSample(row.baseSample || row.sample).toLowerCase() === 'bsa';
    }

    function matchedBsaKey(row) {
      return [
        row.plate || '',
        row.dilution || '',
        row.spot,
      ].map((value) => String(value).toLowerCase()).join('::');
    }

    function dataDumpRows() {
      const bsaRows = new Map();
      state.means.forEach((row, index) => {
        if (isBsaMean(row)) bsaRows.set(matchedBsaKey(row), index + 2);
      });

      return [
        ['Plate# (Px)', 'unique name', 'Sample', 'Dilution', 'Spot', 'Assay', 'Wells', 'N', 'Mean Signal', 'SD', 'CV %', 'Mean fc over matched bsa'],
        ...state.means.map((row, index) => {
          const rowNumber = index + 2;
          const bsaRow = bsaRows.get(matchedBsaKey(row));
          const foldFormula = !row.calibrator && !row.control && !isBsaMean(row) && bsaRow
            ? `=I${rowNumber}/I${bsaRow}`
            : '';

          return [
            row.plate,
            `=CONCATENATE(C${rowNumber},"_",D${rowNumber},"_",F${rowNumber},"_",A${rowNumber})`,
            row.baseSample || row.sample,
            row.dilution,
            row.spot,
            row.assay,
            row.wells,
            row.n,
            row.mean,
            row.sd,
            row.cv,
            foldFormula,
          ];
        }),
      ];
    }

    function numericOrBlank(value) {
      return Number.isFinite(value) ? value : '';
    }

    function qcSummaryRows() {
      return [
        ['Plate', 'Overall QC', 'Passed Calibrators', 'Review Calibrators', 'Passed Controls', 'Review Controls', 'Caveats', 'Caveat Notes'],
        ...state.plates.map((plate) => {
          const cal = state.qc.filter((row) => row.plate === plate.id);
          const controls = state.controlQc.filter((row) => row.plate === plate.id);
          const caveats = caveatRowsForPlate(plate.id);
          const calPassed = cal.filter((row) => row.status === 'Pass').length;
          const controlPassed = controls.filter((row) => row.status === 'Pass').length;
          const calReviews = cal.length - calPassed;
          const controlReviews = controls.length - controlPassed;

          return [
            plate.id,
            calReviews || controlReviews || caveats.length ? 'Review' : 'Pass',
            calPassed,
            calReviews,
            controlPassed,
            controlReviews,
            caveats.length,
            caveats.map(caveatLabel).join('; '),
          ];
        }),
      ];
    }

    function qcRowsForPlate(plate) {
      const calibrators = state.qc
        .filter((row) => row.plate === plate)
        .map((row) => [
          row.assay,
          row.sample,
          numericOrBlank(row.concentration),
          numericOrBlank(row.calculated),
          numericOrBlank(row.recovery),
          numericOrBlank(row.cv),
          row.range ? row.range.llod : '',
          row.range ? row.range.lloq : '',
          row.range ? row.range.uloq : '',
          row.rangeStatus,
          row.status,
        ]);

      const controls = state.controlQc
        .filter((row) => row.plate === plate)
        .map((row) => [
          row.assay,
          row.sample,
          row.lot,
          numericOrBlank(row.mean),
          numericOrBlank(row.target),
          numericOrBlank(row.expected),
          numericOrBlank(row.calculated),
          numericOrBlank(row.recovery),
          numericOrBlank(row.cv),
          row.recoveryQc,
          row.cvQc,
          row.qc,
        ]);

      return [
        ['Plate', plate],
        [],
        ['Standard curve QC'],
        ['Spot', 'Calibrator', 'Nominal pg/mL', 'Back-fit pg/mL', 'Recovery %', 'Signal CV %', 'LLOD', 'LLOQ', 'ULOQ', 'Range', 'QC'],
        ...calibrators,
        [],
        ['Control QC'],
        ['Spot', 'Control', 'Lot', 'Mean Signal', 'COA pg/mL', 'Expected pg/mL', 'Back-fit pg/mL', 'Recovery %', 'Signal CV %', 'Recovery QC', 'CV QC', 'QC'],
        ...controls,
      ];
    }

    function qcWorkbookSheets() {
      return [
        { name: 'Results', rows: dataDumpRows() },
        { name: 'QC Summary', rows: qcSummaryRows() },
        ...state.plates.map((plate) => ({ name: `${plate.id} QC`, rows: qcRowsForPlate(plate.id) })),
      ];
    }

    function escapeXml(value) {
      return String(value).replace(/[<>&"']/g, (ch) => ({
        '<': '&lt;',
        '>': '&gt;',
        '&': '&amp;',
        '"': '&quot;',
        "'": '&apos;',
      })[ch]);
    }

    function columnName(index) {
      let name = '';
      while (index > 0) {
        const remainder = (index - 1) % 26;
        name = String.fromCharCode(65 + remainder) + name;
        index = Math.floor((index - 1) / 26);
      }
      return name;
    }

    function sheetCellXml(rowIndex, colIndex, value) {
      const ref = `${columnName(colIndex)}${rowIndex}`;
      if (value === null || value === undefined || value === '') return `<c r="${ref}"/>`;
      if (typeof value === 'number' && Number.isFinite(value)) return `<c r="${ref}"><v>${value}</v></c>`;

      const text = String(value);
      if (text.startsWith('=')) return `<c r="${ref}"><f>${escapeXml(text.slice(1))}</f></c>`;
      return `<c r="${ref}" t="inlineStr"><is><t>${escapeXml(text)}</t></is></c>`;
    }

    function worksheetXml(rows) {
      const sheetRows = rows.map((row, rowIndex) => `
        <row r="${rowIndex + 1}">
          ${row.map((value, colIndex) => sheetCellXml(rowIndex + 1, colIndex + 1, value)).join('')}
        </row>
      `).join('');

      return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
        <worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
          <sheetData>${sheetRows}</sheetData>
        </worksheet>`;
    }

    function safeSheetName(name, used) {
      let safe = String(name || 'Sheet').replace(/[\[\]:*?/\\]/g, ' ').trim().slice(0, 31) || 'Sheet';
      let candidate = safe;
      let suffix = 2;

      while (used.has(candidate.toLowerCase())) {
        const suffixText = ` ${suffix}`;
        candidate = `${safe.slice(0, 31 - suffixText.length)}${suffixText}`;
        suffix += 1;
      }

      used.add(candidate.toLowerCase());
      return candidate;
    }

    function xlsxWorkbookBlob(sheets) {
      const usedNames = new Set();
      const namedSheets = sheets.map((sheet, index) => ({
        ...sheet,
        id: index + 1,
        safeName: safeSheetName(sheet.name, usedNames),
      }));

      const files = new Map([
        ['_rels/.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
          <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
            <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>
          </Relationships>`],
        ['xl/_rels/workbook.xml.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
          <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
            ${namedSheets.map((sheet) => `<Relationship Id="rId${sheet.id}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${sheet.id}.xml"/>`).join('')}
          </Relationships>`],
        ['xl/workbook.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
          <workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
            <workbookPr/>
            <sheets>
              ${namedSheets.map((sheet) => `<sheet name="${escapeXml(sheet.safeName)}" sheetId="${sheet.id}" r:id="rId${sheet.id}"/>`).join('')}
            </sheets>
            <calcPr calcMode="auto"/>
          </workbook>`],
        ['[Content_Types].xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
          <Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
            <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
            <Default Extension="xml" ContentType="application/xml"/>
            <Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>
            ${namedSheets.map((sheet) => `<Override PartName="/xl/worksheets/sheet${sheet.id}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`).join('')}
          </Types>`],
      ]);

      namedSheets.forEach((sheet) => {
        files.set(`xl/worksheets/sheet${sheet.id}.xml`, worksheetXml(sheet.rows));
      });

      return zipBlob([...files.entries()].map(([name, content]) => ({ name, content })), 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }

    function crcTable() {
      return Array.from({ length: 256 }, (_, index) => {
        let c = index;
        for (let bit = 0; bit < 8; bit += 1) {
          c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
        }
        return c >>> 0;
      });
    }

    const ZIP_CRC_TABLE = crcTable();

    function crc32(bytes) {
      let crc = 0xffffffff;
      bytes.forEach((byte) => {
        crc = ZIP_CRC_TABLE[(crc ^ byte) & 0xff] ^ (crc >>> 8);
      });
      return (crc ^ 0xffffffff) >>> 0;
    }

    function setZip16(view, offset, value) {
      view.setUint16(offset, value, true);
    }

    function setZip32(view, offset, value) {
      view.setUint32(offset, value >>> 0, true);
    }

    function zipBlob(files, type) {
      const encoder = new TextEncoder();
      const localParts = [];
      const centralParts = [];
      let offset = 0;

      files.forEach((file) => {
        const name = encoder.encode(file.name);
        const data = encoder.encode(file.content);
        const crc = crc32(data);

        const local = new Uint8Array(30 + name.length);
        const localView = new DataView(local.buffer);
        setZip32(localView, 0, 0x04034b50);
        setZip16(localView, 4, 20);
        setZip32(localView, 14, crc);
        setZip32(localView, 18, data.length);
        setZip32(localView, 22, data.length);
        setZip16(localView, 26, name.length);
        local.set(name, 30);
        localParts.push(local, data);

        const central = new Uint8Array(46 + name.length);
        const centralView = new DataView(central.buffer);
        setZip32(centralView, 0, 0x02014b50);
        setZip16(centralView, 4, 20);
        setZip16(centralView, 6, 20);
        setZip32(centralView, 16, crc);
        setZip32(centralView, 20, data.length);
        setZip32(centralView, 24, data.length);
        setZip16(centralView, 28, name.length);
        setZip32(centralView, 42, offset);
        central.set(name, 46);
        centralParts.push(central);

        offset += local.length + data.length;
      });

      const centralSize = centralParts.reduce((sum, part) => sum + part.length, 0);
      const end = new Uint8Array(22);
      const endView = new DataView(end.buffer);
      setZip32(endView, 0, 0x06054b50);
      setZip16(endView, 8, files.length);
      setZip16(endView, 10, files.length);
      setZip32(endView, 12, centralSize);
      setZip32(endView, 16, offset);

      return new Blob([...localParts, ...centralParts, end], { type });
    }

    function downloadBlob(blob, name) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.click();
      URL.revokeObjectURL(url);
    }

    function showErrors(errors) {
      el('errors').innerHTML = errors.map((message) => `<div class="error">${escapeHtml(message)}</div>`).join('');
    }

    function plateUploadTemplate(plateId, removable) {
      const rowId = nextPlateUploadId;
      nextPlateUploadId += 1;

      return `
        <div class="plate-upload" data-plate-upload>
          <div class="plate-upload-head">
            <div class="mini-label">Plate</div>
            ${removable ? '<button class="secondary plate-remove" type="button" data-remove-plate>Remove</button>' : ''}
          </div>
          <input type="text" value="${escapeHtml(plateId)}" aria-label="Plate number" data-plate-id>
          <div class="plate-upload-files">
            <label class="mini-file" for="rawFile${rowId}">
              TXT
              <input id="rawFile${rowId}" type="file" accept=".txt,.csv,.tsv,text/plain,text/csv" data-raw-file>
            </label>
            <label class="mini-file" for="mapFile${rowId}">
              CSV
              <input id="mapFile${rowId}" type="file" accept=".csv,.txt,.tsv,text/plain,text/csv" data-map-file>
            </label>
          </div>
        </div>
      `;
    }

    function addPlateUpload(removable = true) {
      const plateId = `p${nextPlateNumber}`;
      nextPlateNumber += 1;
      el('plateUploads').insertAdjacentHTML('beforeend', plateUploadTemplate(plateId, removable));
    }

    function resetReadState() {
      state.plates = [];
      hidePlatePreview();
    }

    function activePlateUploadRows() {
      return [...el('plateUploads').querySelectorAll('[data-plate-upload]')]
        .map((row, index) => ({
          index,
          id: normalizePlateId(row.querySelector('[data-plate-id]').value, `p${index + 1}`),
          rawFile: row.querySelector('[data-raw-file]').files[0],
          mapFile: row.querySelector('[data-map-file]').files[0],
        }))
        .filter((row) => row.rawFile || row.mapFile);
    }

    async function readPlateUploadRows() {
      const rows = activePlateUploadRows();
      if (!rows.length) return [];

      const seen = new Set();
      const duplicates = rows
        .map((row) => row.id.toLowerCase())
        .filter((id) => {
          if (seen.has(id)) return true;
          seen.add(id);
          return false;
        });

      if (duplicates.length) throw new Error(`Plate numbers need to be unique. ${duplicates.join(', ')} is repeated.`);

      return Promise.all(rows.map(async (row) => {
        if (!row.rawFile || !row.mapFile) {
          throw new Error(`${row.id} needs both a TXT signal export and a CSV plate map.`);
        }

        const plate = {
          id: row.id,
          rawName: row.rawFile.name,
          mapName: row.mapFile.name,
          rawText: await row.rawFile.text(),
          mapText: await row.mapFile.text(),
        };

        return {
          ...plate,
          map: parsePlateMap(plate.mapText),
          raw: parseSignals(plate.rawText, state.spotNames),
        };
      }));
    }

    const DEMO_SPOTS = ['IFN-γ', 'IL-1β', 'IL-2', 'IL-4', 'IL-5', 'IL-6', 'KC/GRO', 'IL-10', 'IL-12p70', 'TNF-α'];
    const DEMO_SAMPLES = [
      [
        'IL-36β/IL-1F8', 'IL-17I/IL-17A', 'IL-17F', 'IL-33', 'IL-23', 'IL-12',
        'IL-6', 'IL-3', 'IL-22', 'IL-24', 'IL-7', 'IL-20', 'IL-4',
        'CCL20/MIP-3α', 'IL-9', 'CCL17/TARC', 'B2M',
      ],
      [
        'IL-18/IL-1F4', 'IL-11', 'IL-1α/IL-1F1', 'IL-1β/IL-1F2', 'IL-17E/IL-25',
        'IL-17C', 'IL-2', 'IL-10', 'IL-28A/IFN-λ2', 'IL-27', 'IL-19', 'IL-5',
        'IL-28B/IFN-λ3', 'CCL11/Eotaxin', 'IL-36γ/IL-1F9', 'IL-36α/IL-1F6', 'CCL22/MDC',
      ],
      [
        'IL-15', 'CCL2/MCP-1', 'IL-27 p28/IL-30', 'IL-34', 'CCL19/MIP-3β',
        'IL-21', 'CCL3/MIP-1α', 'CCL4/MIP-1β', 'CCL12/MCP-5', 'IL-1ra/IL-1F3',
        'CCL5/RANTES', 'CCL21/6Ckine', 'IL-13', 'IL-31', 'IL-17B', 'CCL7/MCP-3', 'CXCL10/IP-10',
      ],
    ];

    function demoNoise(seed) {
      const x = Math.sin(seed * 12.9898) * 43758.5453;
      return x - Math.floor(x);
    }

    function demoSignalForConcentration(spot, concentration) {
      const top = [960000, 640000, 340000, 1100000, 880000, 1900000, 1250000, 980000, 760000, 520000][spot - 1];
      const background = [82, 165, 145, 980, 120, 100, 180, 210, 1800, 118][spot - 1];
      const cal1 = CALIBRATOR_A0080440.get(normalizeSpotName(DEMO_SPOTS[spot - 1])) || 1000;
      const half = cal1 / 8;
      return background + top * concentration / (concentration + half);
    }

    function demoSampleConcentration(baseSample, dilution, plate, spot) {
      const assay = normalizeSpotName(DEMO_SPOTS[spot - 1]);
      const sample = normalizeSpotName(baseSample);
      let concentration = 0.07 + spot * 0.01;

      if (sample === assay) concentration = 420;
      if (sample.includes('il-1b') && assay === 'il-1b') concentration = 360;
      if (sample === 'il-4' && assay === 'il-4') concentration = 260;
      if (sample === 'il-5' && assay === 'il-5') concentration = 320;
      if (sample === 'il-6' && assay === 'il-6') concentration = 920;
      if (sample === 'il-12' && assay === 'kc/gro') concentration = 180;

      if (plate === 'p3' && dilution === '1:2' && ['il-10', 'il-12p70', 'tnf-a'].includes(assay)) {
        concentration += 34 + spot * 1.5;
      }

      if (sample.includes('il-15') && assay === 'il-10') concentration += 180;
      if (dilution === '1:8') concentration /= 3.2;
      return concentration;
    }

    function demoPlateData(plateIndex) {
      const plate = `p${plateIndex + 1}`;
      const groups = [
        ...Array.from({ length: 8 }, (_, index) => `cal${index + 1}`),
        'cntrl 1',
        'cntrl 2',
        'cntrl 3',
        'BSA_dil2',
        'BSA_dil8',
        ...DEMO_SAMPLES[plateIndex].flatMap((sample) => [`${sample}_dil2`, `${sample}_dil8`]),
      ];
      const wells = [];
      ROWS.forEach((row) => {
        for (let col = 1; col <= 12; col += 1) wells.push(`${row}${String(col).padStart(2, '0')}`);
      });

      const mapRows = [['Well', 'Sample']];
      const signalRows = [['Well', 'Spot', 'Signal']];
      wells.forEach((well, index) => {
        const group = groups[Math.floor(index / 2)];
        if (!group) return;

        mapRows.push([well, group]);
        const { sample, dilution } = parsePlateEntry(group);
        const level = calibratorLevel(sample);
        const control = controlLevel(sample);
        const baseSample = canonicalSample(sample);

        for (let spot = 1; spot <= 10; spot += 1) {
          const assay = normalizeSpotName(DEMO_SPOTS[spot - 1]);
          let concentration = 0.05;

          if (Number.isFinite(level)) {
            const cal1 = CALIBRATOR_A0080440.get(assay) || 1000;
            concentration = cal1 / (4 ** Math.max(0, level - 1));
          } else if (Number.isFinite(control)) {
            concentration = (DEFAULT_CONTROL_TARGETS.get(assay)?.[control] || 1) / 2;
          } else if (baseSample.toLowerCase() === 'bsa') {
            concentration = dilution === '1:8' ? 0.025 : 0.04;
            if (plate === 'p3' && dilution === '1:2' && ['il-10', 'il-12p70', 'tnf-a'].includes(assay)) {
              concentration = 0.006;
            }
          } else {
            concentration = demoSampleConcentration(baseSample, dilution, plate, spot);
          }

          const replicate = index % 2;
          const signal = Math.round(demoSignalForConcentration(spot, concentration) * (0.975 + demoNoise(index * 71 + spot * 13) * 0.05 + replicate * 0.006));
          signalRows.push([well, DEMO_SPOTS[spot - 1], signal]);
        }
      });

      return {
        id: plate,
        rawName: `${plate}-demo.txt`,
        mapName: `${plate}-demo-map.csv`,
        rawText: signalRows.map((row) => row.join(',')).join('\n'),
        mapText: mapRows.map((row) => row.join(',')).join('\n'),
      };
    }

    function loadDemoData() {
      el('spotNames').value = DEMO_SPOTS.join('\n');
      el('cal1Neat').checked = true;
      el('cal8Blank').checked = false;
      el('dilutionFactor').value = '4';
      el('fitMode').value = '4pl';
      el('newCalLot').checked = false;
      el('newControlLot').checked = false;
      el('calCoaPaste').value = '';
      el('controlCoaPaste').value = '';
      el('analysisCaveats').value = 'p3, 1:2, IL-10, IL-12p70, TNF-α: lower matched BSA signal';
      updateCoaPasteVisibility();

      state.spotNames = parseSpotNames();
      state.plates = [0, 1, 2].map(demoPlateData).map((plate) => ({
        ...plate,
        map: parsePlateMap(plate.mapText),
        raw: parseSignals(plate.rawText, state.spotNames),
      }));
      state.analysisCaveats = parseAnalysisCaveats();
      renderPlatePreview();
      showErrors([]);
      renderWarnings();
    }

    function updateCoaPasteVisibility() {
      el('calCoaPasteWrap').classList.toggle('hidden', !el('newCalLot').checked);
      el('controlCoaPasteWrap').classList.toggle('hidden', !el('newControlLot').checked);
    }

    el('analyze').addEventListener('click', async () => {
      const errors = [];
      hidePlatePreview();

      try {
        state.spotNames = parseSpotNames();
        applyCoaOverrides();
        state.plates = await readPlateUploadRows();
        state.analysisCaveats = parseAnalysisCaveats();
      } catch (error) {
        errors.push(error.message);
      }
      if (!state.plates.length && !errors.length) errors.push('Add a TXT signal export and CSV plate map for at least one plate.');

      showErrors(errors);
      if (errors.length) return;

      renderPlatePreview();
      showErrors([]);
    });

    el('confirmAnalyze').addEventListener('click', () => {
      try {
        applyCoaOverrides();
        state.analysisCaveats = parseAnalysisCaveats();
        compute();
        renderAll();
        hidePlatePreview();
        showErrors([]);
      } catch (error) {
        showErrors([error.message]);
      }
    });

    el('addPlate').addEventListener('click', () => {
      addPlateUpload();
      resetReadState();
    });

    el('loadDemo').addEventListener('click', () => {
      try {
        loadDemoData();
      } catch (error) {
        showErrors([error.message]);
      }
    });

    el('plateUploads').addEventListener('click', (event) => {
      if (!event.target.matches('[data-remove-plate]')) return;

      event.target.closest('[data-plate-upload]').remove();
      resetReadState();
    });

    el('plateUploads').addEventListener('change', resetReadState);

    ['newCalLot', 'newControlLot'].forEach((id) => {
      el(id).addEventListener('change', () => {
        updateCoaPasteVisibility();
        resetReadState();
      });
    });
    ['calCoaPaste', 'controlCoaPaste'].forEach((id) => {
      el(id).addEventListener('input', resetReadState);
    });
    el('analysisCaveats').addEventListener('input', () => {
      if (!state.plates.length) return;
      try {
        state.analysisCaveats = parseAnalysisCaveats();
        renderSamples();
        renderQc();
      } catch {
        // The Read plates step will show caveat format errors once the user is done typing.
      }
    });

    [false, false, false].forEach((removable) => addPlateUpload(removable));
    updateCoaPasteVisibility();

    el('recheckControls').addEventListener('click', () => {
      computeControlQc();
      renderQc();
    });
    ['controlPrepReconstVolume', 'controlPrepDilution', 'controlLot1', 'controlLot2', 'controlLot3'].forEach((id) => {
      el(id).addEventListener('input', () => {
        computeControlQc();
        renderQc();
      });
      el(id).addEventListener('change', () => {
        computeControlQc();
        renderQc();
      });
    });
    el('samplesView').addEventListener('change', (event) => {
      if (event.target.id === 'sampleMode') {
        state.sampleMode = event.target.value;
        renderSamples();
      }
      if (event.target.id === 'sampleDilution') {
        state.sampleDilution = event.target.value;
        renderSamples();
      }
    });
    el('fitMode').addEventListener('change', () => state.means.length && refitCurves(true));
    ['dilutionFactor', 'cal1Neat', 'cal8Blank'].forEach((id) => {
      el(id).addEventListener('input', applyDilutionSeries);
      el(id).addEventListener('change', applyDilutionSeries);
    });
    document.querySelectorAll('.tab').forEach((button) => {
      button.addEventListener('click', () => setTab(button.dataset.tab));
    });

    el('downloadWorkbook').addEventListener('click', () => {
      downloadBlob(xlsxWorkbookBlob(qcWorkbookSheets()), 'msd-results-qc.xlsx');
    });

    el('downloadCurves').addEventListener('click', downloadCurvesPng);
    el('downloadSamples').addEventListener('click', () => downloadCanvasPng(drawSamplePng(), 'sample-graphs.png'));
    el('downloadFoldSummary').addEventListener('click', () => downloadCanvasPng(drawFoldSummaryPng(), 'fold-change-summary.png'));
    el('downloadControls').addEventListener('click', () => downloadCanvasPng(drawControlsPng(), 'control-graphs.png'));
  </script>
