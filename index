  <script>
    const ROWS = 'ABCDEFGH'.split('');
    const MOUSE_LIMITS = new Map([
      ['ifn-g', { llod: 0.04, lloq: 0.390, uloq: 570 }],
      ['il-1b', { llod: 0.11, lloq: 2.04, uloq: 1030 }],
