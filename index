      let y = titleHeight + margin;
      panels.forEach((panel, index) => {
        drawFoldSummaryPanel(ctx, {
          x: margin,
          y,
          width: panelWidth,
          height: panelHeights[index],
          sampleWidth,
          cellWidth,
          rowHeight,
          headerHeight,
          maxAbs,
          caveats: caveatsForRows(panel.rows),
          ...panel,
        });
        y += panelHeights[index] + gap;
      });

      return canvas;
    }

