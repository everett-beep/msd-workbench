<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MSD Signal Workbench</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #17212f;
      --muted: #687383;
      --line: #d9dee7;
      --soft: #f3f6fa;
      --panel: #ffffff;
      --accent: #0f766e;
      --accent-2: #b45309;
      --good: #047857;
      --good-soft: #ecfdf5;
      --good-line: #6ee7b7;
      --warn: #fff7ed;
      --warn-line: #fdba74;
      --bad: #b42318;
      --bad-soft: #fff1f0;
      --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: #f8fafc;
    }

    button,
    input,
    textarea,
    select {
      color: inherit;
      font: inherit;
    }

    .app {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 360px minmax(0, 1fr);
    }

    .side {
      padding: 24px;
      background: #ffffff;
      border-right: 1px solid var(--line);
      position: sticky;
      top: 0;
      align-self: start;
      min-height: 100vh;
    }

    .brand {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 22px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      background: conic-gradient(from 210deg, #0f766e, #2563eb, #b45309, #0f766e);
      box-shadow: inset 0 0 0 7px #fff, 0 0 0 1px var(--line);
      flex: 0 0 auto;
    }

    h1 {
      margin: 0;
      font-size: 20px;
      line-height: 1.1;
      letter-spacing: 0;
    }

    .subtitle {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.4;
    }

    .field {
      margin-top: 18px;
    }

    .field.compact {
      margin-top: 0;
    }

    .field.compact + .field.compact {
      margin-top: 12px;
    }

    .field label,
    .mini-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 7px;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
    }

    .hint {
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
    }

    .file {
      display: grid;
      gap: 8px;
      align-items: center;
      justify-items: center;
      min-height: 96px;
      padding: 16px;
      border: 1px dashed #aab4c3;
      border-radius: 8px;
      background: var(--soft);
      text-align: center;
      cursor: pointer;
    }

    .file input {
      width: 100%;
      max-width: 250px;
      font-size: 12px;
    }

    .file strong {
      font-size: 13px;
    }

    textarea,
    input[type="text"],
    input[type="number"] {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: #fff;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }

    textarea {
      min-height: 148px;
      resize: vertical;
      padding: 10px 12px;
      line-height: 1.45;
    }

    input[type="text"],
    input[type="number"] {
      height: 34px;
      padding: 0 9px;
    }

    textarea:focus,
    input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .plate-list {
      display: grid;
      gap: 12px;
      margin-top: 10px;
    }

    .plate-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }

    .plate-upload {
      display: grid;
      gap: 10px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--soft);
    }

    .plate-upload-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .plate-upload-files {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .mini-file {
      display: grid;
      gap: 6px;
      min-width: 0;
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .mini-file input {
      width: 100%;
      min-width: 0;
      font-size: 11px;
      text-transform: none;
      letter-spacing: 0;
    }

    .plate-remove {
      min-height: 28px;
      padding: 0 10px;
      font-size: 12px;
    }

    .export-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .check-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }

    .check {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 8px 10px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: #fff;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .check input {
      width: 16px;
      height: 16px;
      margin: 0;
      accent-color: var(--accent);
    }

    .coa-paste {
      margin-top: 12px;
    }

    .coa-paste textarea {
      min-height: 92px;
      font-size: 12px;
      line-height: 1.35;
    }

    textarea.short-paste {
      min-height: 84px;
      font-size: 12px;
      line-height: 1.35;
    }

    .primary,
    .secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 6px;
      border: 1px solid transparent;
      cursor: pointer;
      font-weight: 800;
      transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
    }

    .primary {
      width: 100%;
      margin-top: 18px;
      background: var(--accent);
      color: #fff;
      box-shadow: 0 10px 22px rgba(15, 118, 110, 0.28);
    }

    .secondary {
      background: #fff;
      border-color: var(--line);
    }

    .primary:hover,
    .secondary:hover {
      transform: translateY(-1px);
    }

    .primary:disabled {
      cursor: not-allowed;
      background: #94a3b8;
      box-shadow: none;
      transform: none;
    }

    .secondary:disabled {
      cursor: not-allowed;
      color: #94a3b8;
      background: var(--soft);
      transform: none;
    }

    .panel-head .primary {
      width: auto;
      margin-top: 0;
      white-space: nowrap;
    }

    .main {
      padding: 24px;
      display: grid;
      gap: 18px;
      align-content: start;
    }

    .status {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .metric,
    .panel {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
      box-shadow: var(--shadow);
    }

    .metric {
      padding: 15px;
    }

    .metric span {
      display: block;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .metric strong {
      display: block;
      margin-top: 7px;
      font-size: 28px;
      line-height: 1;
      letter-spacing: 0;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 16px 18px;
      border-bottom: 1px solid var(--line);
    }

    .panel-title {
      margin: 0;
      font-size: 16px;
      line-height: 1.2;
      letter-spacing: 0;
    }

    .panel-body {
      padding: 18px;
    }

    .empty {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
    }

    .tabs {
      display: inline-flex;
      padding: 3px;
      gap: 2px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--soft);
    }

    .tab {
      min-height: 32px;
      padding: 0 12px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      cursor: pointer;
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    .tab.active {
      background: #fff;
      color: var(--ink);
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.12);
    }

    .hidden {
      display: none !important;
    }

    .spot-map {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }

    .spot-chip {
      min-width: 0;
      padding: 9px 10px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--soft);
    }

    .spot-chip strong,
    .spot-chip span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .spot-chip strong {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
    }

    .spot-chip span {
      margin-top: 3px;
      font-size: 13px;
      font-weight: 800;
    }

    .spot-chip em {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
      font-style: normal;
    }

    .table-wrap {
      max-height: 440px;
      overflow: auto;
      border: 1px solid var(--line);
      border-radius: 8px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th,
    td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--line);
      text-align: right;
      white-space: nowrap;
    }

    th:first-child,
    td:first-child,
    th:nth-child(2),
    td:nth-child(2) {
      text-align: left;
    }

    th {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--soft);
      color: #475569;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    .chart-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    #qcView .chart-grid {
      margin: 14px 0;
    }

    .chart {
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }

    .chart-title {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: baseline;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 800;
    }

    .chart-title span {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
    }

    .sample-tools {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 12px;
      margin-bottom: 14px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--soft);
    }

    .sample-tools .field {
      min-width: 220px;
      margin: 0;
    }

    .sample-legend {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 6px 14px;
      margin-bottom: 14px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: #475569;
      background: #fff;
      font-size: 12px;
      line-height: 1.3;
    }

    .sample-legend span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-weight: 800;
      color: var(--ink);
    }

    .sample-legend i {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 3px;
      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.12);
    }

    .sample-legend i.coa-key {
      width: 18px;
      height: 0;
      border-radius: 0;
      border-top: 3px dashed var(--accent-2);
      background: transparent;
      box-shadow: none;
    }

    .heatmap-wrap {
      max-width: 100%;
      overflow: auto;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }

    .heatmap {
      display: grid;
      min-width: 920px;
      gap: 1px;
      background: var(--line);
      font-size: 12px;
    }

    .heatmap-head,
    .heatmap-sample,
    .heatmap-cell {
      min-height: 34px;
      padding: 7px 8px;
      background: #fff;
    }

    .heatmap-head,
    .heatmap-sample {
      position: sticky;
      z-index: 1;
      color: #475569;
      background: var(--soft);
      font-weight: 800;
    }

    .heatmap-head {
      top: 0;
      text-align: center;
    }

    .heatmap-sample {
      left: 0;
      min-width: 136px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .heatmap-cell {
      min-width: 78px;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .curve-legend {
      display: inline-flex;
      gap: 12px;
      align-items: center;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }

    .legend-item {
      display: inline-flex;
      gap: 4px;
      align-items: center;
    }

    .legend-dot,
    .legend-triangle {
      display: inline-block;
      width: 9px;
      height: 9px;
      background: var(--accent-2);
    }

    .legend-dot {
      border-radius: 999px;
    }

    .legend-triangle {
      background: #2563eb;
      clip-path: polygon(50% 0, 0 100%, 100% 100%);
    }

    .combined-chart {
      display: grid;
      gap: 12px;
      margin-bottom: 14px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }

    .combined-chart canvas {
      display: block;
      width: 100%;
      max-width: 1120px;
      height: auto;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: #fff;
    }

    svg {
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .axis {
      stroke: #cbd5e1;
      stroke-width: 1;
    }

    .grid {
      stroke: #e2e8f0;
      stroke-width: 1;
    }

    .fit {
      fill: none;
      stroke: var(--accent);
      stroke-width: 2.5;
    }

    .pt {
      fill: var(--accent-2);
      stroke: #fff;
      stroke-width: 1.5;
    }

    .control-pt {
      fill: #2563eb;
      stroke: #fff;
      stroke-width: 1.5;
    }

    .coa-line,
    .measured-line {
      fill: none;
      stroke-width: 2.5;
    }

    .coa-line {
      stroke: #b45309;
      stroke-dasharray: 5 4;
    }

    .measured-line {
      stroke: #2563eb;
    }

    .coa-pt {
      fill: #b45309;
      stroke: #fff;
      stroke-width: 1.5;
    }

    .measured-pt {
      fill: #2563eb;
      stroke: #fff;
      stroke-width: 1.5;
    }

    .sample-bar {
      fill: #2563eb;
    }

    .sample-label {
      fill: #475569;
      font-size: 10px;
    }

    .warn {
      padding: 12px 14px;
      border: 1px solid var(--warn-line);
      border-radius: 8px;
      background: var(--warn);
      color: #7c2d12;
      line-height: 1.45;
      font-size: 13px;
    }

    .errors {
      display: grid;
      gap: 8px;
      margin-top: 12px;
    }

    .preview-list {
      display: grid;
      gap: 12px;
    }

    .preview-card {
      display: grid;
      gap: 8px;
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }

    .preview-card strong {
      font-size: 16px;
    }

    .preview-card p {
      margin: 0;
      color: var(--muted);
      line-height: 1.45;
    }

    .preview-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .preview-tags span {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--soft);
      color: #334155;
      font-size: 12px;
      font-weight: 800;
    }

    .confirm-row {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 14px;
    }

    .error,
    .warning {
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.4;
    }

    .error {
      background: var(--bad-soft);
      color: var(--bad);
    }

    .warning {
      border: 1px solid var(--warn-line);
      background: var(--warn);
      color: #7c2d12;
    }

    .qc-note {
      margin: 8px 0 0;
    }

    .qc-summary {
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.4;
    }

    .qc-summary.pass {
      border-color: var(--good-line);
      background: var(--good-soft);
      color: #065f46;
    }

    .qc-summary.review {
      border-color: var(--warn-line);
      background: var(--warn);
      color: #7c2d12;
    }

    .qc-badge {
      display: inline-flex;
      align-items: center;
      min-height: 22px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      line-height: 1;
    }

    .qc-badge.pass {
      background: var(--good-soft);
      color: var(--good);
      box-shadow: inset 0 0 0 1px var(--good-line);
    }

    .qc-badge.review {
      background: var(--warn);
      color: #b45309;
      box-shadow: inset 0 0 0 1px var(--warn-line);
    }

    .cal-table input {
      width: 92px;
      text-align: right;
    }

    @media (max-width: 980px) {
      .app {
        grid-template-columns: 1fr;
      }

      .side {
        position: static;
        min-height: 0;
      }

      .status,
      .chart-grid,
      .spot-map {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 640px) {
      .side,
      .main {
        padding: 16px;
      }

      .status,
      .chart-grid,
      .plate-upload-files,
      .spot-map,
      .row {
        grid-template-columns: 1fr;
      }

      .panel-head {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <aside class="side">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true"></div>
        <div>
          <h1>MSD Signal Workbench</h1>
          <p class="subtitle">Mean duplicate wells and fit one 4PL standard curve for each spot.</p>
        </div>
      </div>

      <div class="field">
        <div class="mini-label">
          Plate files
          <span class="hint">TXT + CSV for each plate</span>
        </div>
        <div id="plateUploads" class="plate-list"></div>
        <div class="plate-actions">
          <button id="addPlate" class="secondary" type="button">Add another plate</button>
          <button id="loadDemo" class="secondary" type="button">Load demo data</button>
        </div>
      </div>

      <div class="field">
        <label for="spotNames">Kit spot names 1-10 <span class="hint">one line per spot</span></label>
        <textarea id="spotNames" spellcheck="false">Spot 1
Spot 2
Spot 3
Spot 4
Spot 5
Spot 6
Spot 7
Spot 8
Spot 9
Spot 10</textarea>
      </div>

      <div class="row field">
        <div>
          <div class="mini-label">Calibrator match</div>
          <input id="calPattern" type="text" value="cal|calibrator|std|standard" aria-label="Calibrator match">
        </div>
        <div>
          <div class="mini-label">Fit</div>
          <select id="fitMode" class="secondary" aria-label="Curve fit mode">
            <option value="4pl">4PL weighted</option>
            <option value="linear">linear</option>
          </select>
        </div>
      </div>

      <div class="field">
        <div class="mini-label">Dilution factor</div>
        <input id="dilutionFactor" type="number" min="1" step="any" value="4" aria-label="Dilution factor">
      </div>

      <div class="check-row">
        <label class="check" for="cal1Neat">
          <input id="cal1Neat" type="checkbox" checked>
          Cal 1 is neat
        </label>
        <label class="check" for="cal8Blank">
          <input id="cal8Blank" type="checkbox">
          Cal 8 is blank
        </label>
      </div>

      <div class="field">
        <div class="mini-label">COA lots <span class="hint">optional override</span></div>
        <div class="check-row">
          <label class="check" for="newCalLot">
            <input id="newCalLot" type="checkbox">
            New calibrator lot
          </label>
          <label class="check" for="newControlLot">
            <input id="newControlLot" type="checkbox">
            New control lot
          </label>
        </div>
        <div id="calCoaPasteWrap" class="coa-paste hidden">
          <label for="calCoaPaste">Paste calibrator COA values <span class="hint">spot + Cal 1 pg/mL</span></label>
          <textarea id="calCoaPaste" spellcheck="false" placeholder="IFN-γ 991&#10;IL-1β 1640"></textarea>
        </div>
        <div id="controlCoaPasteWrap" class="coa-paste hidden">
          <label for="controlCoaPaste">Paste control COA values <span class="hint">spot + Control 1–3 pg/mL</span></label>
