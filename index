        el(`controlLot${level}`).value = state.controlLots[level] || DEFAULT_CONTROL_LOTS[level];
      });
    }

    function renderMeans() {
      const rows = state.means.map((row) => `
        <tr>
          <td>${escapeHtml(row.plate)}</td>
          <td>${escapeHtml(row.sample)}</td>
          <td>${escapeHtml(row.assay)}</td>
          <td>${escapeHtml(row.dilution)}</td>
          <td>${escapeHtml(row.wells)}</td>
          <td>${row.n}</td>
