    function drawSampleBarCard(ctx, chart, foldMode, x, y, width, height) {
      const plot = { x: x + 62, y: y + 70, w: width - 92, h: height - 118 };
      const rows = chart.rows;
      const slot = plot.h / Math.max(1, rows.length);
      const barHeight = Math.max(5, Math.min(14, slot - 6));
      const maxY = Math.max(1, ...rows.map((row) => row.mean));
      const maxAbs = Math.max(1, ...rows.map((row) => Math.abs(row.log2Fold)).filter(Number.isFinite));
      const sxRaw = (value) => plot.x + (value / maxY) * plot.w;
      const sxFold = (value) => plot.x + ((value + maxAbs) / (maxAbs * 2)) * plot.w;
      const zeroX = foldMode ? sxFold(0) : plot.x;

      drawCardFrame(ctx, x, y, width, height, chart.assay, `${rows.length} samples`);
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      [0, 0.5, 1].forEach((t) => {
        const gx = plot.x + plot.w * t;
        ctx.beginPath();
        ctx.moveTo(gx, plot.y);
        ctx.lineTo(gx, plot.y + plot.h);
        ctx.stroke();
      });
      ctx.strokeStyle = '#cbd5e1';
      ctx.beginPath();
      ctx.moveTo(plot.x, plot.y);
      ctx.lineTo(plot.x, plot.y + plot.h);
      ctx.lineTo(plot.x + plot.w, plot.y + plot.h);
      ctx.stroke();

      rows.forEach((row, index) => {
        if (foldMode && !Number.isFinite(row.log2Fold)) return;
        const bx = foldMode ? sxFold(Math.min(0, row.log2Fold)) : plot.x;
        const by = plot.y + index * slot + (slot - barHeight) / 2;
        const barWidth = foldMode ? Math.abs(sxFold(row.log2Fold) - zeroX) : sxRaw(row.mean) - plot.x;
        ctx.fillStyle = row.legend?.color || SAMPLE_COLORS[0];
        ctx.beginPath();
        ctx.roundRect(bx, by, Math.max(1, barWidth), barHeight, 2);
        ctx.fill();

        ctx.fillStyle = '#475569';
        ctx.font = '13px Inter, Arial, sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText(row.legend?.key || '', plot.x - 10, by + barHeight / 2);
      });

      ctx.fillStyle = '#687383';
      ctx.font = '500 13px Inter, Arial, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText(foldMode ? `-${fmt(maxAbs, 2)}` : '0', plot.x, plot.y + plot.h + 20);
      if (foldMode) {
        ctx.textAlign = 'center';
        ctx.fillText('0', zeroX, plot.y + plot.h + 20);
      }
      ctx.textAlign = 'right';
      ctx.fillText(foldMode ? `+${fmt(maxAbs, 2)}` : fmt(maxY), plot.x + plot.w, plot.y + plot.h + 20);
      ctx.textAlign = 'left';
      ctx.fillText(foldMode ? 'log2 fold over matched BSA' : 'Mean sample signal', plot.x, y + height - 18);
    }

    function drawSampleHeatmapPng(rows, sampleNames, sampleMode) {
