    const DEFAULT_CONTROL_LOTS = { 1: 'A00C0931', 2: 'A00C0932', 3: 'A00C0933' };
    const DEFAULT_CONTROL_TARGETS = new Map([
      ['ifn-g', { 1: 504, 2: 34.4, 3: 2.36 }],
      ['il-1b', { 1: 782, 2: 55.0, 3: 4.81 }],
      ['il-2', { 1: 951, 2: 67.7, 3: 5.67 }],
      ['il-4', { 1: 586, 2: 91.0, 3: 16.5 }],
      ['il-5', { 1: 398, 2: 60.6, 3: 9.48 }],
      ['il-6', { 1: 1680, 2: 251, 3: 34.6 }],
      ['kc/gro', { 1: 842, 2: 110, 3: 17.8 }],
      ['il-10', { 1: 1060, 2: 323, 3: 121 }],
      ['il-12p70', { 1: 19800, 2: 3840, 3: 581 }],
      ['tnf-a', { 1: 113, 2: 28.3, 3: 5.43 }],
    ]);
    const CONTROL_COA_RECONST_VOLUME = 250;
    const CONTROL_RECOVERY_MIN = 80;
    const CONTROL_RECOVERY_MAX = 120;
    const CONTROL_INTRARUN_CV_MAX = 7;

    const state = {
      rawText: '',
      mapText: '',
      plates: [],
      spotNames: [],
      raw: null,
      map: null,
      means: [],
      standards: [],
      curves: [],
      qc: [],
      controlQc: [],
      calibrators: [],
      controls: [],
      calibratorNeats: cloneDefaultCalibratorNeats(),
      controlTargets: cloneDefaultControlTargets(),
      controlLots: { ...DEFAULT_CONTROL_LOTS },
      controlReconstVolume: 250,
      controlDilution: 2,
      analysisCaveats: [],
      sampleMode: 'raw-by-assay',
      sampleDilution: 'all',
      sampleBaseline: '',
      rawCoverage: [],
      activeTab: 'means',
    };
    let nextPlateUploadId = 1;
    let nextPlateNumber = 1;
    const SAMPLE_MODE_LABELS = new Map([
      ['raw-by-assay', 'Raw signal by analyte'],
      ['raw-log', 'All raw signals, log'],
      ['fold-by-assay', 'BSA fold change by analyte'],
      ['fold-log', 'All BSA fold changes, log2'],
      ['fold-summary', 'BSA FC heat map summary'],
    ]);
    const SAMPLE_COLORS = [
      '#2563eb', '#be123c', '#0f766e', '#b45309', '#7c3aed', '#0891b2',
      '#65a30d', '#db2777', '#475569', '#ea580c', '#0d9488', '#4f46e5',
      '#ca8a04', '#0284c7', '#9333ea', '#16a34a', '#e11d48', '#64748b',
    ];
    const PLATE_COLORS = ['#2563eb', '#db2777', '#0f766e', '#b45309', '#7c3aed', '#0891b2'];

    const el = (id) => document.getElementById(id);
    const fmt = (value, digits = 3) => Number.isFinite(value)
      ? Number(value).toLocaleString(undefined, { maximumSignificantDigits: digits })
      : '';
    const average = (values) => values.reduce((a, b) => a + b, 0) / values.length;
    const stdev = (values) => {
      if (values.length < 2) return 0;
      const mean = average(values);
      return Math.sqrt(values.reduce((acc, v) => acc + (v - mean) ** 2, 0) / (values.length - 1));
    };

    function normalizeWell(value) {
      const match = String(value || '').trim().toUpperCase().match(/^([A-P])\s*0?([1-9]|1[0-9]|2[0-4])$/);
      if (!match) return '';
      return `${match[1]}${String(Number(match[2])).padStart(2, '0')}`;
    }

    function splitLine(line) {
      const comma = parseDelimitedLine(line, ',');
      const tab = parseDelimitedLine(line, '\t');
      if (tab.length > comma.length) return tab.map(cleanCell);
      if (comma.length > 1) return comma.map(cleanCell);
      return line.trim().split(/\s+/).map(cleanCell);
    }

    function parseDelimitedLine(line, delimiter) {
      const out = [];
      let cell = '';
      let quote = false;
      for (let i = 0; i < line.length; i += 1) {
        const ch = line[i];
        if (ch === '"') {
          if (quote && line[i + 1] === '"') {
            cell += '"';
            i += 1;
          } else {
            quote = !quote;
          }
        } else if (ch === delimiter && !quote) {
          out.push(cell);
          cell = '';
        } else {
          cell += ch;
        }
      }
      out.push(cell);
      return out;
    }

    function cleanCell(value) {
      return String(value || '').replace(/^\uFEFF/, '').trim();
    }

    function parseDilution(value) {
      let text = canonicalSample(value);
      const suffix = text.match(/^dil(\d+(?:\.\d+)?)$/i);
      if (suffix) return `1:${fmtPlain(Number(suffix[1]))}`;

      text = text
        .replace(/^(?:sample\s*)?(?:dil(?:ution)?|df|fold)\s*[:=]?\s*/i, '');
      if (!text) return '';

      text = text
        .replace(/^undiluted$/i, 'neat')
        .replace(/\s+/g, '');

      const ratio = text.match(/^1[:/](\d+(?:\.\d+)?)$/);
      if (ratio) return `1:${fmtPlain(Number(ratio[1]))}`;

      const fold = text.match(/^(\d+(?:\.\d+)?)(?:x|×|fold)?$/i);
      if (fold) return `${fmtPlain(Number(fold[1]))}x`;

      return text;
    }

    function fmtPlain(value) {
      return Number.isInteger(value) ? String(value) : String(value);
    }

    function parsePlateEntry(value, dilution = '') {
      let sample = canonicalSample(value);
      let parsedDilution = parseDilution(dilution);
      if (parsedDilution) return { sample, dilution: parsedDilution };

      const dilSuffix = sample.match(/^(.*)_dil(\d+(?:\.\d+)?)$/i);
      if (dilSuffix) {
        return {
          sample: canonicalSample(dilSuffix[1]),
          dilution: parseDilution(`dil${dilSuffix[2]}`),
        };
      }

      const patterns = [
        /^(.*?)\s*(?:[@|;])\s*(.+)$/i,
        /^(.*?)\s*\((\s*(?:dil(?:ution)?|df|fold)?\s*[:=]?\s*(?:neat|undiluted|1\s*[:/]\s*\d+(?:\.\d+)?|\d+(?:\.\d+)?\s*(?:x|×|fold))\s*)\)$/i,
        /^(.*?)\s+(dil(?:ution)?|df|fold)\s*[:=]?\s*(.+)$/i,
        /^(.*?)\s+(1\s*[:/]\s*\d+(?:\.\d+)?|\d+(?:\.\d+)?\s*(?:x|×|fold))$/i,
      ];

      for (const pattern of patterns) {
        const match = sample.match(pattern);
        if (!match) continue;

        const maybeSample = canonicalSample(match[1]);
        const maybeDilution = parseDilution(match[3] || match[2]);
        if (maybeSample && maybeDilution) {
          sample = maybeSample;
          parsedDilution = maybeDilution;
          break;
        }
      }

      return { sample, dilution: parsedDilution };
    }

    function parseGridPlateMap(text) {
      const lines = text.split(/\r?\n/).filter((line) => line.trim());
      const map = new Map();
      for (const line of lines) {
        const cells = splitLine(line);
        const rowLabel = cells[0] && cells[0].trim().toUpperCase();
        if (!ROWS.includes(rowLabel)) continue;

        const values = cells.slice(1);
        for (let i = 0; i < Math.min(12, values.length); i += 1) {
          if (values[i]) map.set(`${rowLabel}${String(i + 1).padStart(2, '0')}`, parsePlateEntry(values[i]));
        }
      }
      return map;
    }

    function parseTidyPlateMap(text) {
      const lines = text.split(/\r?\n/).filter((line) => line.trim());
      for (let headerIndex = 0; headerIndex < Math.min(10, lines.length); headerIndex += 1) {
        const header = splitLine(lines[headerIndex]).map((h) => h.toLowerCase());
        const wellIndex = header.findIndex((h) => ['well', 'well id', 'wellid'].includes(h) || h.includes('well'));
        const nameIndex = header.findIndex((h) => /(sample|name|contents|id|description)/.test(h) && h !== 'well id');
        const dilutionIndex = header.findIndex((h) => /\b(dilution|dil|df|fold)\b/.test(h));
        if (wellIndex < 0 || nameIndex < 0) continue;

        const map = new Map();
        for (const line of lines.slice(headerIndex + 1)) {
          const cells = splitLine(line);
          const well = normalizeWell(cells[wellIndex]);
          const name = cleanCell(cells[nameIndex]);
          if (well && name) map.set(well, parsePlateEntry(name, cells[dilutionIndex]));
        }
        return map;
      }
      return new Map();
    }

    function parsePlateMap(text) {
      const grid = parseGridPlateMap(text);
      const tidy = parseTidyPlateMap(text);
      const map = grid.size >= tidy.size ? grid : tidy;
      if (!map.size) {
        throw new Error('The plate map needs either A-H rows with 12 CSV cells or columns for Well and Sample/Name.');
      }
      return map;
    }

    function numeric(value) {
      const cleaned = String(value || '').replace(/,/g, '').replace(/[<>]/g, '').trim();
      if (!cleaned || cleaned.toLowerCase() === 'nan') return NaN;
      const n = Number(cleaned);
      return Number.isFinite(n) ? n : NaN;
    }

    function spotIndexFromHeader(header, fallback) {
      const lower = String(header || '').toLowerCase();
      const explicit = lower.match(/spot\D*(\d+)/) || lower.match(/(?:signal|ecl)\D*(\d+)/);
      if (explicit) return Number(explicit[1]);
      if (/^\d+$/.test(lower.trim())) return Number(lower.trim());
      return fallback;
    }

    function parseWellPerRow(lines) {
      for (let i = 0; i < Math.min(lines.length, 80); i += 1) {
        const header = splitLine(lines[i]);
        const lower = header.map((h) => h.toLowerCase());
        const wellIndex = lower.findIndex((h) => h === 'well' || h === 'well id' || h === 'wellid');
        if (wellIndex < 0) continue;

        const spotCols = header
          .map((h, index) => ({ h, index }))
          .filter(({ h, index }) => index !== wellIndex && Number.isFinite(spotIndexFromHeader(h, NaN)));

        if (!spotCols.length) continue;

        const byWell = new Map();
        for (const line of lines.slice(i + 1)) {
          const cells = splitLine(line);
          const well = normalizeWell(cells[wellIndex]);
          if (!well) continue;

          const values = byWell.get(well) || new Map();
          spotCols.forEach(({ h, index }, fallback) => {
            const value = numeric(cells[index]);
            if (Number.isFinite(value)) {
              values.set(spotIndexFromHeader(h, fallback + 1), value);
            }
          });
          byWell.set(well, values);
        }
        if (byWell.size) return byWell;
      }
      return new Map();
    }

    function spotIndexFromValue(value, spotNames) {
      const normalized = normalizeSpotName(value);
      const exactSpot = spotNames.findIndex((name) => name && normalizeSpotName(name) === normalized);
      if (exactSpot >= 0) return exactSpot + 1;

      const numericSpot = normalized.match(/^(?:spot\s*)?0?(\d{1,2})$/);
      return numericSpot ? Number(numericSpot[1]) : NaN;
    }

    function signalCount(byWell) {
      return [...byWell.values()].reduce((sum, spots) => sum + spots.size, 0);
    }

    function parseTidySignals(lines, spotNames) {
      for (let i = 0; i < Math.min(lines.length, 80); i += 1) {
        const header = splitLine(lines[i]).map((h) => h.toLowerCase());
        const wellIndex = header.findIndex((h) => h === 'well' || h === 'well id' || h === 'wellid');
        const spotIndex = header.findIndex((h) =>
          h === 'spot' || h === 'spot id' || h === 'spot number' || h === 'assay' || h === 'analyte'
        );
        const signalIndex = header.findIndex((h) => /(signal|ecl|count|mean)/.test(h));
        if (wellIndex < 0 || spotIndex < 0 || signalIndex < 0) continue;

        const byWell = new Map();
        for (const line of lines.slice(i + 1)) {
          const cells = splitLine(line);
          const well = normalizeWell(cells[wellIndex]);
          const spot = spotIndexFromValue(cells[spotIndex], spotNames);
          const value = numeric(cells[signalIndex]);
          if (!well || !spot || !Number.isFinite(value)) continue;

          if (!byWell.has(well)) byWell.set(well, new Map());
          byWell.get(well).set(spot, value);
        }
        if (byWell.size) return byWell;
      }
      return new Map();
    }

    function isBlockHeader(cells) {
      const numericHeader = cells.filter((cell) => /^\d{1,2}$/.test(cell)).map(Number);
      return numericHeader.length >= 8 && numericHeader[0] === 1;
    }

    function stackedSignalValues(cells) {
      const values = cells.slice();
      if (ROWS.includes(values[0]?.toUpperCase())) values.shift();
      while (values[0] === '') values.shift();
      const signals = values.slice(0, 12);
      return signals.length === 12 && signals.every((value) => Number.isFinite(numeric(value)))
        ? signals
        : null;
    }

    function parseStackedWellRows(lines) {
      const byWell = new Map();

      for (let i = 0; i < lines.length; i += 1) {
        const cells = splitLine(lines[i]);
        if (!isBlockHeader(cells)) continue;

        for (let j = i + 1; j < lines.length; j += 1) {
          const firstRow = splitLine(lines[j]);
          const row = firstRow[0]?.toUpperCase();
          if (!ROWS.includes(row)) continue;

          const firstValues = stackedSignalValues(firstRow);
          if (!firstValues) continue;

          const stack = [firstValues];
          for (let spot = 2; spot <= 10 && j + spot - 1 < lines.length; spot += 1) {
            const values = splitLine(lines[j + spot - 1]);
            const signals = stackedSignalValues(values);
            if (signals) stack.push(signals);
          }

          if (stack.length !== 10) continue;

          stack.forEach((values, spotIndex) => {
            values.forEach((cell, col) => {
              const well = `${row}${String(col + 1).padStart(2, '0')}`;
              if (!byWell.has(well)) byWell.set(well, new Map());
              byWell.get(well).set(spotIndex + 1, numeric(cell));
            });
          });
          j += 9;
        }
      }

      return byWell;
    }

    function parsePlateBlocks(lines) {
      const byWell = new Map();
      const blocks = [];

      for (let i = 0; i < lines.length; i += 1) {
        const cells = splitLine(lines[i]);
        if (!isBlockHeader(cells)) continue;

        const rows = [];
        for (let j = i + 1; j < lines.length && rows.length < ROWS.length; j += 1) {
          const rowCells = splitLine(lines[j]);
          if (ROWS.includes(rowCells[0]?.toUpperCase()) && rowCells.length >= 9) {
            rows.push(rowCells);
          } else if (isBlockHeader(rowCells)) {
            break;
          }
        }

        if (rows.length >= ROWS.length) {
          blocks.push(rows);
        }
      }

      blocks.forEach((rows, blockIndex) => {
        const spot = blockIndex + 1;
        rows.forEach((cells) => {
          cells.slice(1, 13).forEach((cell, col) => {
            const value = numeric(cell);
            if (!Number.isFinite(value)) return;
            const well = `${cells[0].toUpperCase()}${String(col + 1).padStart(2, '0')}`;
            if (!byWell.has(well)) byWell.set(well, new Map());
            byWell.get(well).set(spot, value);
          });
        });
      });
      return byWell;
    }

    function parseSignals(text, spotNames) {
      const lines = text.split(/\r?\n/).filter((line) => line.trim());
      const parsers = [
        () => parseTidySignals(lines, spotNames),
        () => parseWellPerRow(lines),
        () => parseStackedWellRows(lines),
        () => parsePlateBlocks(lines),
      ];
      let best = new Map();
      for (const parser of parsers) {
        const out = parser();
        if (signalCount(out) > signalCount(best)) best = out;
      }
      if (best.size) return best;
      throw new Error('No raw signal table was found. Use a Workbench export with Well rows or Each Spot As Plate blocks.');
    }

    function canonicalSample(name) {
      return String(name || '').trim().replace(/\s+/g, ' ');
    }

    function displaySample(sample, dilution, plate = '') {
      const suffixes = [dilution, state.plates.length > 1 ? plate : ''].filter(Boolean);
      return suffixes.length ? `${sample} (${suffixes.join(', ')})` : sample;
    }

    function sampleGroupKey(plate, sample, dilution) {
      return `${plate.toLowerCase()}::${sample.toLowerCase()}::${dilution.toLowerCase()}`;
    }

    function normalizeSpotName(name) {
      return stripSpotOrdinal(name)
        .toLowerCase()
        .replace(/[α]/g, 'a')
        .replace(/[β]/g, 'b')
        .replace(/[γ]/g, 'g')
        .replace(/^(?:assay|analyte|spot name|spot)\s*:\s*/, '');
    }

    function stripSpotOrdinal(name) {
      return canonicalSample(name)
        .replace(/^(?:spot\s*)?\d{1,2}\s*[\.)\-:]?\s*/, '');
    }

    function displaySpotName(name) {
      return stripSpotOrdinal(name);
    }

    function dedupeSpotName(name, index) {
      const stripped = displaySpotName(name);
      return stripped || `Spot ${index + 1}`;
    }

    function normalizeSpotNameForError(name) {
      return displaySpotName(name)
        .toLowerCase()
        .replace(/[α]/g, 'a')
        .replace(/[β]/g, 'b')
        .replace(/[γ]/g, 'g');
    }

    function compactCaveatText(value) {
      return normalizeSpotName(value)
        .replace(/[^a-z0-9]+/g, '');
    }

    function normalizePlateId(value, fallback) {
      const text = cleanCell(value);
      if (!text) return fallback;

      const numeric = text.match(/^(\d+)$/);
      return numeric ? `p${Number(numeric[1])}` : text;
    }

    function parseSpotNames() {
      const names = el('spotNames').value
        .split(/\r?\n/)
        .map(dedupeSpotName)
        .filter(Boolean);

      if (names.length !== 10) {
        throw new Error(`Paste exactly 10 spot names, one per line. I found ${names.length}.`);
      }

      const seen = new Map();
      names.forEach((name, index) => {
        const key = normalizeSpotName(name);
        if (!seen.has(key)) seen.set(key, []);
        seen.get(key).push({ spot: index + 1, name });
      });

      const duplicates = [...seen.entries()].filter(([, entries]) => entries.length > 1);
      if (duplicates.length) {
        const duplicateText = duplicates
          .map(([, entries]) => {
            const spots = entries.map((entry) => entry.spot).join(', ');
            return `${normalizeSpotNameForError(entries[0].name)} on spots ${spots}`;
          })
          .join('; ');
        throw new Error(`Each spot needs one unique name. Duplicate spot names found: ${duplicateText}.`);
      }

      return names;
    }

    function escapedPattern() {
      return el('calPattern').value
        .split('|')
        .map((part) => part.trim())
        .filter(Boolean)
        .map((part) => part.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .join('|');
    }

    function calibratorLevel(name) {
      const pattern = escapedPattern() || 'cal|std';
      const re = new RegExp(`(?:${pattern})\\D*0*(\\d+)`, 'i');
      const explicit = String(name).match(re);
      if (explicit) return Number(explicit[1]);
      const generic = String(name).match(/(\d+(?:\.\d+)?)/);
      return generic ? Number(generic[1]) : NaN;
    }

    function isCalibrator(name) {
      const pattern = escapedPattern() || 'cal|std';
      return new RegExp(pattern, 'i').test(name);
    }

    function controlLevel(name) {
      const text = String(name || '').trim();
      const named = text.match(/\b(?:control|cntrl|ctrl|qc)\D*0*([123])\b/i);
      if (named) return Number(named[1]);

      const lotLevel = Object.entries(getControlLots()).find(([, lot]) => lot && lot.toLowerCase() === text.toLowerCase());
      return lotLevel ? Number(lotLevel[0]) : NaN;
    }

    function isControl(name) {
      return Number.isFinite(controlLevel(name));
    }

    function concentrationFromName(name) {
      const match = String(name).match(/(\d+(?:\.\d+)?)\s*(?:pg|ng|ug|µg|mg|pm|nm|um|µm)\s*\/?\s*(?:ml|l)?/i);
      return match ? Number(match[1]) : NaN;
    }

    function parseAnalysisCaveats() {
      return cleanCell(el('analysisCaveats')?.value || '')
        .split(/\r?\n/)
        .map(cleanCell)
        .filter(Boolean)
        .map((line, index) => {
          const normalizedLine = line.toLowerCase();
          const compactLine = compactCaveatText(line);
          const plate = state.plates.find((entry) => {
            const escaped = entry.id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const numeric = entry.id.match(/^p(\d+)$/i);
            return new RegExp(`\\b${escaped}\\b`, 'i').test(line)
              || (numeric && new RegExp(`\\b(?:p|plate)\\s*0*${numeric[1]}\\b`, 'i').test(line));
          })?.id;
          const ratio = normalizedLine.match(/\b1\s*[:/]\s*(\d+(?:\.\d+)?)\b/);
          const suffix = normalizedLine.match(/\bdil\s*0*(\d+(?:\.\d+)?)\b/);
          const dilution = ratio
            ? `1:${fmtPlain(Number(ratio[1]))}`
            : suffix
              ? `1:${fmtPlain(Number(suffix[1]))}`
              : '';
          const assays = state.spotNames
            .map((assay) => ({ key: normalizeSpotName(assay), assay }))
            .filter(({ assay }) => compactLine.includes(compactCaveatText(assay)));
          const note = cleanCell(line.match(/:\s+(.+)$/)?.[1]) || 'Review caveat';

          if (!plate || !dilution || !assays.length) {
            throw new Error(`Caveat ${index + 1} needs a plate, dilution, and at least one spot name.`);
          }

          return {
            plate,
            dilution,
            assayKeys: new Set(assays.map((assay) => assay.key)),
            assays: assays.map((assay) => assay.assay),
            note,
          };
        });
    }

    function standardKey(row) {
      return `${row.spot}::${row.sample}`;
    }

    function defaultCalibratorNeat(assay) {
      return CALIBRATOR_A0080440.get(normalizeSpotName(assay)) || 0;
    }

    function generatedConcentration(row, index, neats = getCalibratorNeats()) {
      const neat = neats[normalizeSpotName(row.assay)] ?? defaultCalibratorNeat(row.assay);
      const dilution = Math.max(1, numeric(el('dilutionFactor').value) || 1);
      const level = Number.isFinite(row.level) ? row.level : index + 1;
      if (isBlankCalibrator(row, index)) return 0;

      const firstExponent = el('cal1Neat').checked ? 1 : 0;
      const exponent = Math.max(0, level - firstExponent);
      return neat / dilution ** exponent;
    }

    function isBlankCalibrator(cal, index) {
      const level = Number.isFinite(cal.level) ? cal.level : index + 1;
      return el('cal8Blank').checked && level === 8;
    }

    function getCalibratorNeats() {
      const neats = { ...state.calibratorNeats };

      state.spotNames.forEach((assay) => {
        const key = normalizeSpotName(assay);
        if (!Number.isFinite(neats[key]) || neats[key] <= 0) {
          neats[key] = defaultCalibratorNeat(assay);
        }
      });

      state.calibratorNeats = neats;
      return neats;
    }

    function findCoaAssayKey(line, knownKeys) {
      const normalized = normalizeSpotName(line);
      return knownKeys.find((key) => normalized.includes(key));
    }

    function parseCoaRows(text, knownKeys, expectedValues) {
      return String(text || '')
        .split(/\r?\n/)
        .map((line) => cleanCell(line))
        .filter(Boolean)
        .map((line) => {
          const assay = findCoaAssayKey(line, knownKeys);
          if (!assay) return null;

          const numberText = normalizeSpotName(line).replace(assay, ' ');
          const values = [...numberText.matchAll(/-?\d+(?:,\d{3})*(?:\.\d+)?/g)]
            .map((match) => numeric(match[0]))
            .filter(Number.isFinite);
          if (values.length > expectedValues && values[0] >= 1 && values[0] <= 10 && Number.isInteger(values[0])) {
            values.shift();
          }

          return {
            assay,
            values,
          };
        })
        .filter((row) => row && row.values.length);
    }

    function parseCalibratorCoa(text) {
      const rows = parseCoaRows(text, [...CALIBRATOR_A0080440.keys()], 1);
      const values = { ...cloneDefaultCalibratorNeats() };
      let matched = 0;

      rows.forEach((row) => {
        const key = row.assay;
        if (!CALIBRATOR_A0080440.has(key)) return;
        values[key] = row.values[0];
        matched += 1;
      });

      if (!matched) throw new Error('Paste calibrator COA rows with analyte names and Cal 1 concentrations.');
      return values;
    }

    function parseControlCoa(text) {
      const rows = parseCoaRows(text, [...DEFAULT_CONTROL_TARGETS.keys()], 3);
      const values = cloneDefaultControlTargets();
      let matched = 0;

      rows.forEach((row) => {
        const key = row.assay;
        if (!DEFAULT_CONTROL_TARGETS.has(key) || row.values.length < 3) return;
        values[key] = { 1: row.values[0], 2: row.values[1], 3: row.values[2] };
        matched += 1;
      });

      if (!matched) throw new Error('Paste control COA rows with analyte names and Control 1, 2, and 3 concentrations.');
      return values;
    }

    function applyCoaOverrides() {
      state.calibratorNeats = el('newCalLot').checked
        ? parseCalibratorCoa(el('calCoaPaste').value)
        : cloneDefaultCalibratorNeats();
      state.controlTargets = el('newControlLot').checked
        ? parseControlCoa(el('controlCoaPaste').value)
        : cloneDefaultControlTargets();
    }

    function compute() {
      state.spotNames = parseSpotNames();

      state.plates = state.plates.map((plate) => ({
        ...plate,
        map: parsePlateMap(plate.mapText),
        raw: parseSignals(plate.rawText, state.spotNames),
      }));
      state.rawCoverage = getRawCoverage();

      const groups = new Map();
      state.plates.forEach((plate) => {
        plate.map.forEach((entry, well) => {
          const signals = plate.raw.get(well);
          if (!signals) return;
          const baseSample = canonicalSample(entry.sample ?? entry);
          const calibrator = isCalibrator(baseSample);
          const control = !calibrator && isControl(baseSample);
          const dilution = calibrator || control ? '' : parseDilution(entry.dilution);
          const key = sampleGroupKey(plate.id, baseSample, dilution);

          if (!groups.has(key)) {
            groups.set(key, {
              plate: plate.id,
              sample: displaySample(baseSample, dilution, plate.id),
              baseSample,
              dilution,
              wells: [],
              signals: new Map(),
              calibrator,
              control,
            });
          }
          const group = groups.get(key);
          group.wells.push(well);
          signals.forEach((value, spot) => {
            if (!group.signals.has(spot)) group.signals.set(spot, []);
            group.signals.get(spot).push(value);
          });
        });
      });

      state.means = [];
      groups.forEach((group) => {
        const level = group.calibrator ? calibratorLevel(group.baseSample) : NaN;
        const controlLevelValue = group.control ? controlLevel(group.baseSample) : NaN;

        for (let spot = 1; spot <= state.spotNames.length; spot += 1) {
          const values = group.signals.get(spot) || [];
          if (!values.length) continue;
          const mean = average(values);
          const sd = stdev(values);
          state.means.push({
            plate: group.plate,
            sample: group.sample,
            baseSample: group.baseSample,
            dilution: group.dilution,
            spot,
            assay: state.spotNames[spot - 1] || `Spot ${spot}`,
            wells: group.wells.join(' '),
            n: values.length,
            mean,
            sd,
            cv: mean ? (sd / mean) * 100 : 0,
            calibrator: group.calibrator,
            level,
            control: group.control,
            controlLevel: controlLevelValue,
          });
        }
      });

      const seen = new Map();
      state.means
        .filter((row) => row.calibrator)
        .forEach((row) => {
          if (!seen.has(row.sample)) {
            seen.set(row.sample, {
              sample: row.sample,
              level: Number.isFinite(row.level) ? row.level : seen.size + 1,
              concentration: concentrationFromName(row.sample),
            });
          }
        });
      state.calibrators = [...seen.values()].sort((a, b) => a.level - b.level || a.sample.localeCompare(b.sample));

      state.standards = state.means
        .filter((row) => row.calibrator)
        .sort((a, b) => a.spot - b.spot || a.level - b.level || a.sample.localeCompare(b.sample));

      state.controls = state.means
        .filter((row) => row.control)
        .sort((a, b) => a.spot - b.spot || a.controlLevel - b.controlLevel || a.sample.localeCompare(b.sample));

      getCalibratorNeats();
      refitCurves(false);
    }

    function getRawCoverage() {
      return state.spotNames.map((assay, index) => {
        const spot = index + 1;
        const signals = state.plates.reduce((sum, plate) =>
          sum + [...plate.raw.values()].filter((spots) => Number.isFinite(spots.get(spot))).length
        , 0);
        return { spot, assay, signals };
      });
    }

    function applyDilutionSeries() {
      if (!state.calibrators.length) return;
      refitCurves(true);
    }

    function getCalibratorX() {
      const map = new Map();
      const neats = getCalibratorNeats();
      state.standards.forEach((row) => {
        map.set(standardKey(row), generatedConcentration(row, row.level - 1, neats));
      });
      return map;
    }

    function refitCurves(render = true) {
      const xByStandard = getCalibratorX();
      const bySpot = new Map();
      state.standards.forEach((row) => {
        const x = xByStandard.get(standardKey(row));
        if (Number.isFinite(x) && x > 0 && row.mean > 0) {
          if (!bySpot.has(row.spot)) bySpot.set(row.spot, []);
          bySpot.get(row.spot).push({ x, y: row.mean, sample: row.sample, plate: row.plate });
        }
      });

      state.curves = [];
      bySpot.forEach((points, spot) => {
        points.sort((a, b) => a.x - b.x);
        const model = el('fitMode').value === 'linear' || points.length < 4
          ? fitLinear(points)
          : fit4pl(points);
        const pointsByPlate = new Map();
        points.forEach((point) => {
          if (!pointsByPlate.has(point.plate)) pointsByPlate.set(point.plate, []);
          pointsByPlate.get(point.plate).push(point);
        });
        const plateModels = [...pointsByPlate.entries()]
          .filter(([, platePoints]) => platePoints.length >= 2)
          .map(([plate, platePoints]) => {
            platePoints.sort((a, b) => a.x - b.x);
            return {
              plate,
              points: platePoints,
              model: el('fitMode').value === 'linear' || platePoints.length < 4
                ? fitLinear(platePoints)
                : fit4pl(platePoints),
            };
          })
          .filter((plateCurve) => plateCurve.points.length >= 2);
        state.curves.push({
          spot,
          assay: state.spotNames[spot - 1] || `Spot ${spot}`,
          points,
          model,
          plateModels,
        });
      });

      computeQc();
      computeControlQc();

      if (render) renderAll();
    }

    function cloneDefaultControlTargets() {
      return Object.fromEntries(
        [...DEFAULT_CONTROL_TARGETS.entries()].map(([assay, levels]) => [assay, { ...levels }])
      );
    }

    function cloneDefaultCalibratorNeats() {
      return Object.fromEntries(
        [...CALIBRATOR_A0080440.entries()]
      );
    }

    function getControlLots() {
      const lots = { ...state.controlLots };
      [1, 2, 3].forEach((level) => {
        const input = el(`controlLot${level}`);
        lots[level] = cleanCell(input?.value || lots[level] || DEFAULT_CONTROL_LOTS[level]);
      });
      state.controlLots = lots;
      return lots;
    }

    function getControlReconstVolume() {
      const parsed = numeric(el('controlPrepReconstVolume')?.value);
      state.controlReconstVolume = Number.isFinite(parsed) && parsed > 0 ? parsed : 250;
      return state.controlReconstVolume;
    }

    function getControlDilution() {
      const parsed = numeric(el('controlPrepDilution')?.value);
      state.controlDilution = Number.isFinite(parsed) && parsed > 0 ? parsed : 2;
      return state.controlDilution;
    }

    function getControlTargets() {
      const targets = {
        ...cloneDefaultControlTargets(),
        ...Object.fromEntries(Object.entries(state.controlTargets).map(([assay, levels]) => [assay, { ...levels }])),
      };

      state.controlTargets = targets;
      return targets;
    }

    function computeControlQc() {
      const curveByAssay = new Map(state.curves.map((curve) => [normalizeSpotName(curve.assay), curve]));
      const targets = getControlTargets();
      const lots = getControlLots();
      const reconstVolume = getControlReconstVolume();
      const dilution = getControlDilution();

      state.controlQc = state.controls.map((row) => {
        const assayKey = normalizeSpotName(row.assay);
        const target = targets[assayKey]?.[row.controlLevel];
        const curve = curveByAssay.get(assayKey);
        const calculated = curve?.model?.inverse?.(row.mean);
        const expected = Number.isFinite(target) && reconstVolume > 0 && dilution > 0
          ? (target * CONTROL_COA_RECONST_VOLUME) / reconstVolume / dilution
          : NaN;
        const recovery = expected > 0 && Number.isFinite(calculated)
          ? (calculated / expected) * 100
          : NaN;
        const cvPass = row.cv < CONTROL_INTRARUN_CV_MAX;
        const recoveryPass = Number.isFinite(recovery)
          && recovery >= CONTROL_RECOVERY_MIN
          && recovery <= CONTROL_RECOVERY_MAX;
        const missingTarget = !Number.isFinite(target) || target <= 0;
        const status = Number.isFinite(target) && target > 0 && cvPass && recoveryPass ? 'Pass' : 'Review';

        return {
          ...row,
          reconstVolume,
          dilution,
          target,
          expected,
          calculated,
          recovery,
          curveAssay: curve?.assay || row.assay,
          lot: lots[row.controlLevel] || '',
          cvPass,
          recoveryPass,
          recoveryQc: recoveryPass ? 'Within 20%' : 'Outside 20%',
          cvQc: cvPass ? 'CV < 7%' : 'CV >= 7%',
          qc: missingTarget
            ? 'Missing target'
            : [
              recoveryPass ? '' : 'outside 20% expected',
              cvPass ? '' : 'CV >= 7%',
            ].filter(Boolean).join(' / ') || 'Pass',
          status,
        };
      });
    }

    function computeQc() {
      const concentrationByStandard = getCalibratorX();
      const curveBySpot = new Map(state.curves.map((curve) => [curve.spot, curve]));

      state.qc = state.standards.map((row) => {
        const concentration = concentrationByStandard.get(standardKey(row));
        const curve = curveBySpot.get(row.spot);
        const range = MOUSE_LIMITS.get(normalizeSpotName(row.assay));
        const calculated = curve?.model?.inverse?.(row.mean);
        const recovery = concentration > 0 && Number.isFinite(calculated)
          ? (calculated / concentration) * 100
          : NaN;
        const cvPass = row.cv <= 25;
        const recoveryPass = concentration === 0 || (Number.isFinite(recovery) && recovery >= 75 && recovery <= 125);
        const rangeStatus = concentrationRangeStatus(concentration, range);

        return {
          ...row,
          concentration,
          calculated,
          recovery,
          rangeStatus,
          cvPass,
          recoveryPass,
          range,
          status: cvPass && recoveryPass ? 'Pass' : 'Review',
        };
      });
    }

    function concentrationRangeStatus(concentration, range) {
      if (!range || !Number.isFinite(concentration)) return '';
      if (concentration < range.llod) return 'Below LLOD';
      if (concentration < range.lloq) return 'Below LLOQ';
      if (concentration > range.uloq) return 'Above ULOQ';
      return 'In range';
    }

    function fitLinear(points) {
      const n = points.length;
      const sx = points.reduce((a, p) => a + p.x, 0);
      const sy = points.reduce((a, p) => a + p.y, 0);
      const sxx = points.reduce((a, p) => a + p.x * p.x, 0);
      const sxy = points.reduce((a, p) => a + p.x * p.y, 0);
      const denom = n * sxx - sx * sx || 1;
      const slope = (n * sxy - sx * sy) / denom;
      const intercept = (sy - slope * sx) / n;
      const predict = (x) => intercept + slope * x;
      const inverse = (y) => slope ? (y - intercept) / slope : NaN;
      return {
        type: 'Linear',
        r2: rSquared(points, predict),
        predict,
        inverse,
      };
    }

    function fourPL(params, x) {
      const [bottom, top, logEc50, hill] = params;
      const ec50 = Math.exp(logEc50);
      return bottom + (top - bottom) / (1 + (ec50 / x) ** hill);
    }

    function fit4pl(points) {
      const xs = points.map((p) => p.x);
      const ys = points.map((p) => p.y);
      const minY = Math.min(...ys);
      const maxY = Math.max(...ys);
      const midX = Math.exp(average(xs.map(Math.log)));
      const rising = points[0].y <= points[points.length - 1].y;
      const start = [minY, maxY, Math.log(midX), rising ? 1 : -1];
      const scales = [
        Math.max(1, (maxY - minY) * 0.2),
        Math.max(1, (maxY - minY) * 0.2),
        1,
        0.5,
      ];

      const loss = (params) => points.reduce((sum, point) => {
        const y = fourPL(params, point.x);
        if (!Number.isFinite(y)) return sum + 1e12;
        const weighted = (y - point.y) / Math.max(1, Math.abs(point.y));
        return sum + weighted ** 2;
      }, 0);

      const params = nelderMead(start, scales, loss, 420);
      const predict = (x) => fourPL(params, x);
      const inverse = (y) => inverseFourPL(params, y);
      return {
        type: '4PL',
        r2: rSquared(points, predict),
        params,
        predict,
        inverse,
      };
    }

    function inverseFourPL(params, y) {
      const [bottom, top, logEc50, hill] = params;
      const ratio = (top - bottom) / (y - bottom) - 1;
      if (!Number.isFinite(ratio) || ratio <= 0 || !hill) return NaN;
      return Math.exp(logEc50) / ratio ** (1 / hill);
    }

    function nelderMead(start, scales, loss, iterations) {
      const alpha = 1;
      const gamma = 2;
      const rho = 0.5;
      const sigma = 0.5;
      const simplex = [start];
      for (let i = 0; i < start.length; i += 1) {
        const next = start.slice();
        next[i] += scales[i];
        simplex.push(next);
      }

      let scored = simplex.map((params) => ({ params, score: loss(params) }));
      for (let iter = 0; iter < iterations; iter += 1) {
        scored.sort((a, b) => a.score - b.score);
        const best = scored[0].params;
        const worst = scored[scored.length - 1].params;
        const centroid = best.map((_, index) =>
          scored.slice(0, -1).reduce((sum, item) => sum + item.params[index], 0) / start.length
        );

        const reflected = centroid.map((c, i) => c + alpha * (c - worst[i]));
        const reflectedScore = loss(reflected);

        if (reflectedScore < scored[0].score) {
          const expanded = centroid.map((c, i) => c + gamma * (reflected[i] - c));
          const expandedScore = loss(expanded);
          scored[scored.length - 1] = expandedScore < reflectedScore
            ? { params: expanded, score: expandedScore }
            : { params: reflected, score: reflectedScore };
        } else if (reflectedScore < scored[scored.length - 2].score) {
          scored[scored.length - 1] = { params: reflected, score: reflectedScore };
        } else {
          const contracted = centroid.map((c, i) => c + rho * (worst[i] - c));
          const contractedScore = loss(contracted);
          if (contractedScore < scored[scored.length - 1].score) {
            scored[scored.length - 1] = { params: contracted, score: contractedScore };
          } else {
            for (let i = 1; i < scored.length; i += 1) {
              const shrunk = scored[0].params.map((b, j) => b + sigma * (scored[i].params[j] - b));
              scored[i] = { params: shrunk, score: loss(shrunk) };
            }
          }
        }
      }
      scored.sort((a, b) => a.score - b.score);
      return scored[0].params;
    }

    function rSquared(points, predict) {
      const mean = average(points.map((p) => p.y));
      const ssTot = points.reduce((sum, p) => sum + (p.y - mean) ** 2, 0);
      const ssRes = points.reduce((sum, p) => sum + (p.y - predict(p.x)) ** 2, 0);
      return ssTot ? 1 - ssRes / ssTot : 1;
    }

    function table(headers, rows) {
      return `
        <div class="table-wrap">
          <table>
            <thead><tr>${headers.map((h) => `<th>${h}</th>`).join('')}</tr></thead>
            <tbody>${rows.join('')}</tbody>
          </table>
        </div>
      `;
    }

    function renderAll() {
      el('wellsMetric').textContent = state.plates.reduce((sum, plate) => sum + (plate.map?.size || 0), 0);
      el('signalsMetric').textContent = state.plates.reduce((sum, plate) =>
        sum + [...(plate.raw?.values() || [])].reduce((plateSum, spots) => plateSum + spots.size, 0)
      , 0);
      el('groupsMetric').textContent = new Set(state.means.map((row) => row.sample)).size;
      el('curvesMetric').textContent = state.curves.length;
      el('downloadCurves').disabled = !state.curves.length;
      el('downloadSamples').disabled = !sampleRows().length;
      el('downloadFoldSummary').disabled = !sampleRows().length;
      el('downloadControls').disabled = !state.controlQc.length;

      el('empty').classList.toggle('hidden', state.means.length);
      el('downloadPanel').classList.toggle('hidden', !state.means.length);
      el('spotPanel').classList.toggle('hidden', !state.spotNames.length);
      renderSpotMap();
      renderControlTargets();
      renderMeans();
      renderStandards();
      renderCurves();
      renderSamples();
      renderQc();
      renderWarnings();
      setTab(state.activeTab);
    }

    function renderWarnings() {
      const missing = state.rawCoverage.filter((row) => row.signals === 0);
      el('warnings').innerHTML = missing.length
        ? `<div class="warning">No raw signal values were found for ${missing.map((row) => escapeHtml(row.assay)).join(', ')}. Check that the TXT export includes all 10 stacked spot rows.</div>`
        : '';
    }

    function wellPosition(well) {
      const normalized = normalizeWell(well);
      if (!normalized) return null;
      return {
        row: normalized[0],
        col: Number(normalized.slice(1)),
      };
    }

    function duplicateLayout(entries) {
      const groups = new Map();
      entries.forEach(([well, entry]) => {
        const sample = canonicalSample(entry.sample);
        if (isCalibrator(sample) || isControl(sample)) return;

        const key = sampleGroupKey('', sample, entry.dilution || '');
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key).push(well);
      });

      const counts = new Map();
      groups.forEach((wells) => {
        if (wells.length < 2) return;

        const positions = wells.map(wellPosition).filter(Boolean);
        const rows = new Set(positions.map((position) => position.row));
        const cols = new Set(positions.map((position) => position.col));
        const layout = rows.size === 1
          ? 'duplicates across columns'
          : cols.size === 1
            ? 'duplicates down rows'
            : 'duplicates in a block';
        counts.set(layout, (counts.get(layout) || 0) + 1);
      });

      return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] || 'no duplicates detected';
    }

    function summarizePlate(plate) {
      const entries = [...plate.map.entries()];
      const signalCount = [...plate.raw.values()].reduce((sum, spots) => sum + spots.size, 0);
      const dilutions = [...new Set(entries.map(([, entry]) => entry.dilution).filter(Boolean))]
        .sort((a, b) => numeric(a.split(':').pop()) - numeric(b.split(':').pop()));
      const calibrators = new Set();
      const controls = new Set();
      const bsa = new Set();

      entries.forEach(([, entry]) => {
        const sample = canonicalSample(entry.sample);
        if (isCalibrator(sample)) calibrators.add(sample);
        else if (isControl(sample)) controls.add(sample);
        else if (sample.toLowerCase() === 'bsa') bsa.add(displaySample(sample, entry.dilution));
      });

      return {
        id: plate.id,
        dilutions,
        wells: plate.map.size,
        rawWells: plate.raw.size,
        signals: signalCount,
        layout: duplicateLayout(entries),
        calibrators: calibrators.size,
        controls: controls.size,
        bsa: bsa.size,
        rawName: plate.rawName,
        mapName: plate.mapName,
      };
    }

    function renderPlatePreview() {
      const summaries = state.plates.map(summarizePlate);
      el('platePreview').innerHTML = summaries.map((plate) => `
        <div class="preview-card">
          <strong>${escapeHtml(plate.id)}</strong>
          <p>
            ${plate.dilutions.length ? escapeHtml(plate.dilutions.join(' and ')) : 'No'} dilutions;
            ${plate.layout};
            ${plate.wells} mapped wells;
            ${plate.rawWells} raw wells with ${plate.signals} spot signals.
          </p>
          <div class="preview-tags">
            <span>${plate.calibrators} calibrators</span>
            <span>${plate.controls} controls</span>
            <span>${plate.bsa} BSA groups</span>
          </div>
          <p>${escapeHtml(plate.rawName)} + ${escapeHtml(plate.mapName)}</p>
        </div>
      `).join('');
      el('previewPanel').classList.toggle('hidden', !summaries.length);
    }

    function hidePlatePreview() {
      el('previewPanel').classList.add('hidden');
      el('platePreview').innerHTML = '';
    }

    function renderSpotMap() {
      el('spotMap').innerHTML = state.rawCoverage.map((row) => `
        <div class="spot-chip" title="${escapeHtml(row.assay)}">
          <strong>Spot ${row.spot}</strong>
          <span>${escapeHtml(row.assay)}</span>
          <em>${row.signals} raw wells</em>
        </div>
      `).join('');
    }

    function renderControlTargets() {
      el('controlPanel').classList.toggle('hidden', !state.controls.length);
