    function caveatsForRows(rows) {
      const seen = new Set();
      const caveats = [];
      rows.flatMap(caveatsForRow).forEach((caveat) => {
        const key = caveatLabel(caveat);
        if (seen.has(key)) return;
        seen.add(key);
        caveats.push(caveat);
      });
      return caveats;
    }

